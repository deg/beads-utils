NETTOP_HEADER = ",bytes_in,bytes_out,"

# Claude Code's process shows up in nettop under its version number, e.g.
# `2.1.292.70303` -- the fallback for a session missing from the registry.
VERSION_NAME_RE = re.compile(r"^\d+\.\d+\.\d+$")

API_HOST = "api.anthropic.com"
# Observed 2026-10-07; used when DNS is unavailable at startup.
API_FALLBACK_IPS = {"160.79.104.10", "2607:6bc0::10"}
API_REFRESH_SECONDS = 300
# Carrier-grade NAT space, which Tailscale uses for its overlay addresses.
# Python counts it as neither private nor global. A flow to a Tailscale peer
# is tunnelled: the bytes leave the machine a second time as Tailscale's own
# flow to the peer's real address (or a relay), and that flow is the one
# metered. Counting the inner one too would bill the same bytes twice.
CGNAT = ipaddress.ip_network("100.64.0.0/10")
UNREGISTERED = "(unregistered claude)"

# Rolling-rate tiers, in seconds. Conversational traffic is bursty: one
# request uploads its whole context in a second or two and then the link is
# idle. Averages alone dilute that, so the peak tick of the last minute is
# shown beside them.
RATE_WINDOWS = (5, 60, 900)
PEAK_WINDOW = 60

# Upload cost of a request, for the NEXT column. Claude Code gzips request
# bodies. The ~0.7 bytes per context token comes from home-dir session
# f2206181 ("Brainstorm Claude traffic monitor"), which read one-shot nettop
# per-process totals. Those count only sockets open at that moment, so 0.7 is
# probably low. Images are already compressed; gzip saves only ~25% of their
# base64. The footer shows the ratio measured live, to correct these.
BYTES_PER_TOKEN = 0.7
IMAGE_GZIP_RATIO = 0.75


# --- nettop parsing ---------------------------------------------------------


@dataclass
class Flow:
    conn: str          # nettop's connection string, e.g. 'tcp4 a:1<->b:443'
    remote: str        # the remote address alone, port stripped
    bytes_in: int
    bytes_out: int
    local: str = ""    # the local address, port stripped
    local_port: str = ""


@dataclass
class ProcSample:
    name: str
    pid: int
    flows: list[Flow] = field(default_factory=list)
    bytes_in: int = 0    # the process line: grows for as long as nettop runs,
    bytes_out: int = 0   # including connections that have since closed


def _int(s: str) -> int:
    try:
        return int(s)
    except ValueError:
        return 0


def endpoints(conn: str) -> tuple[str, str, str, str]:
    """(local address, local port, remote address, remote port) of a nettop
    connection string, scope ids (`%en0`) stripped.

    IPv4 endpoints are `addr:port`, IPv6 ones `addr.port` (and the wildcard
    is `*:*` or `*.*`), so the separator depends on the family.
    """
    family, _, rest = conn.partition(" ")
    sep = "." if family.endswith("6") else ":"

    def split(ep: str) -> tuple[str, str]:
        addr, _, port = ep.rpartition(sep) if sep in ep else (ep, "", "")
        return addr.split("%", 1)[0], port

    local, _, remote = rest.partition("<->")
    return (*split(local), *split(remote))


def remote_addr(conn: str) -> str:
    """The remote address of a nettop connection string, port stripped."""
    return endpoints(conn)[2]


class NettopParser:
    """Turns nettop's `-L 0 -x -n -J bytes_in,bytes_out` stream into blocks.

    A block is one sample: a header line, then each process line followed by
    its flow lines. A block is complete only when the next header arrives,
    so the view runs one interval behind the stream.
    """

    def __init__(self):
        self._current: list[ProcSample] | None = None

    def feed(self, line: str) -> list[ProcSample] | None:
        """Consume one line; return the previous block when a header ends it."""
        line = line.rstrip("\n")
        if line == NETTOP_HEADER:
            done, self._current = self._current, []
            return done
        if self._current is None or not line:
            return None
        # Split from the right: a process name may itself contain a comma.
        parts = line.rsplit(",", 3)
        if len(parts) != 4:
            return None
        label, b_in, b_out = parts[0], _int(parts[1]), _int(parts[2])
        if label[:3] in ("tcp", "udp") and " " in label:
            if self._current:
                local, lport, remote, _ = endpoints(label)
                self._current[-1].flows.append(
                    Flow(label, remote, b_in, b_out, local, lport))
            return None
        name, _, pid = label.rpartition(".")  # names contain dots: 2.1.292.70303
        if not pid.isdigit():
            return None
        self._current.append(ProcSample(name, int(pid), bytes_in=b_in, bytes_out=b_out))
        return None


# Unconnected UDP sockets show no remote, so where their bytes went is
# unknown. They are counted as internet -- Tailscale's WireGuard traffic runs
# over one (`udp4 *:41641<->*:*`), as can VPNs, calls and games -- except on
# ports whose protocols never leave the LAN.
LAN_ONLY_UDP_PORTS = {
    "67", "68",      # DHCP
    "137", "138",    # NetBIOS
    "1900",          # SSDP
    "5353",          # mDNS
    "5355",          # LLMNR
}


def flow_kind(conn: str, remote: str, local_port: str) -> str:
    """remote_kind(), plus the call on unconnected UDP sockets.

    Erring toward 'internet' overcounts a LAN-only peer reached through such a
    socket (a Tailscale peer on the same LAN), which is the safer direction
    for a meter.
    """
    if remote in ("*", "") and conn.startswith("udp"):
        return "unknown" if local_port in LAN_ONLY_UDP_PORTS else "internet"
    return remote_kind(remote)


def remote_kind(addr: str) -> str:
    """'internet', 'local' (loopback/LAN/link-local/multicast) or 'unknown'.

    Only 'internet' traffic is metered on a ship, so only it is counted. A
    wildcard remote (`*`) is an unconnected socket and is 'unknown'; an
    unparseable address (a hostname, should `-n` ever be ignored) is assumed
    to be internet rather than silently dropped.
    """
    if addr in ("*", ""):
        return "unknown"
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return "internet"
    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    if (ip.is_loopback or ip.is_private or ip.is_link_local
            or ip.is_multicast or ip.is_unspecified or ip in CGNAT):
        return "local"
    return "internet"


@dataclass
class FlowDelta:
    pid: int
    name: str
    remote: str
    d_in: int
    d_out: int
    kind: str = "internet"
    local: str = ""
    unseen: bool = False  # from a connection too brief to ever appear in nettop


class FlowTracker:
    """Byte deltas between successive blocks, classified per connection.

    A connection's line vanishes from nettop's output once it closes, along
    with whatever it moved since the previous sample: curl fetching 20 MB in
    about 2 s was counted as 9.6 MB by connection lines alone. A streaming
    nettop's *process* line keeps growing for as long as nettop runs,
    closed connections included (verified 2026-10-08, beads-utils-8pt). So:

    - each connection line's growth is counted, with its kind;
    - whatever the process line grew beyond that is recovered: the final
      bytes of connections that closed during
      the interval. It is split among the connections that disappeared from
      that process, by their size. If none disappeared, the connection
      opened and closed between two samples and was never seen, so its kind
      is unknown: it is counted as internet and marked `unseen`.

    The first block is the baseline (traffic from before the monitor
    started). A connection or process first seen later is new, so its whole
    count is. A counter that went backwards means a reused connection string
    or pid.
    """

    # Blocks an absent process is remembered for. Dropping it at once would,
    # if it reappeared with its total intact, count its whole history again;
    # a process that idled 90 s never left nettop's output, but remembering
    # is safe either way (a counter that restarted lower is new, see above).
    FORGET_AFTER = 300

    def __init__(self):
        self._prev: dict[tuple, tuple[int, int, Flow]] | None = None
        self._prev_proc: dict[int, tuple[int, int]] = {}
        self._last_seen: dict[int, int] = {}
        self._blocks = 0

    def update(self, block: list[ProcSample]) -> list[FlowDelta]:
        first = self._prev is None
        prev = self._prev or {}
        cur: dict[tuple, tuple[int, int, Flow]] = {}
        out: list[FlowDelta] = []
        for proc in block:
            flows = self._flow_deltas(proc, prev, cur, first)
            if not first:
                out.extend(flows)
                out.extend(self._closed(proc, flows, prev, cur))
            self._prev_proc[proc.pid] = (proc.bytes_in, proc.bytes_out)
            self._last_seen[proc.pid] = self._blocks
        self._blocks += 1
        for pid in [p for p, b in self._last_seen.items() if self._blocks - b > self.FORGET_AFTER]:
            del self._last_seen[pid], self._prev_proc[pid]
        self._prev = cur
        return out

    @staticmethod
    def _flow_deltas(proc: ProcSample, prev: dict, cur: dict, first: bool) -> list[FlowDelta]:
        out = []
        seen: dict[str, int] = {}
        for flow in proc.flows:
            # Identical strings repeat within a process (several
            # unconnected `udp4 *:*<->*:*` sockets), so number them.
            n = seen.get(flow.conn, 0)
            seen[flow.conn] = n + 1
            key = (proc.pid, flow.conn, n)
            cur[key] = (flow.bytes_in, flow.bytes_out, flow)
            if first:
                continue
            p_in, p_out, _ = prev.get(key, (0, 0, flow))
            d_in, d_out = flow.bytes_in - p_in, flow.bytes_out - p_out
            if d_in < 0 or d_out < 0:
                d_in, d_out = flow.bytes_in, flow.bytes_out
            if d_in or d_out:
                out.append(_delta(proc, flow, d_in, d_out))
        return out

    def _closed(self, proc: ProcSample, flows: list[FlowDelta], prev: dict,
                cur: dict) -> list[FlowDelta]:
        """The process line's growth not explained by its live connections."""
        p_in, p_out = self._prev_proc.get(proc.pid, (0, 0))
        g_in, g_out = proc.bytes_in - p_in, proc.bytes_out - p_out
        if g_in < 0 or g_out < 0:   # a reused pid: everything on the line is new
            g_in, g_out = proc.bytes_in, proc.bytes_out
        r_in = g_in - sum(f.d_in for f in flows)
        r_out = g_out - sum(f.d_out for f in flows)
        r_in, r_out = max(r_in, 0), max(r_out, 0)
        if not (r_in or r_out):
            return []
        gone = [v for k, v in prev.items() if k[0] == proc.pid and k not in cur]
        if not gone:
            return [FlowDelta(proc.pid, proc.name, "", r_in, r_out, "internet", "", unseen=True)]
        weights = [b_in + b_out + 1 for b_in, b_out, _ in gone]
        total = sum(weights)
        out, left_in, left_out = [], r_in, r_out
        for i, ((_, _, flow), w) in enumerate(zip(gone, weights)):
            last = i == len(gone) - 1   # the last share takes the rounding
            s_in = left_in if last else r_in * w // total
            s_out = left_out if last else r_out * w // total
            left_in, left_out = left_in - s_in, left_out - s_out
            if s_in or s_out:
                out.append(_delta(proc, flow, s_in, s_out))
        return out


def _delta(proc: ProcSample, flow: Flow, d_in: int, d_out: int) -> FlowDelta:
    return FlowDelta(proc.pid, proc.name, flow.remote, d_in, d_out,
                     flow_kind(flow.conn, flow.remote, flow.local_port), flow.local)


# --- process tree and session registry ---------------------------------------


def process_table() -> dict[int, tuple[int, str]]:
    """pid -> (ppid, command basename) for every process, from one `ps`."""
    try:
        res = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,comm="],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    table = {}
    for line in res.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        comm = parts[2] if len(parts) > 2 else ""
        table[int(parts[0])] = (int(parts[1]), comm.rsplit("/", 1)[-1])
    return table


def _image_bytes(content) -> list[int]:
    """Encoded sizes of every image block, including inside tool results."""
    out = []
    if isinstance(content, list):
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "image":
                data = (block.get("source") or {}).get("data") or ""
                out.append(len(data))
            out.extend(_image_bytes(block.get("content")))
    return out


class TranscriptWatcher:
    """Follows one transcript by offset, reading only what was appended.

    Tracks what the next request will re-send: the context size from the
    latest main-thread `usage`, and the images since the last
    `compact_boundary` (an image rides along on every request until then).

    Also totals the requests made at or after `since` -- the context tokens
    and image bytes they carried -- so the monitor can measure real upload
    bytes per token against BYTES_PER_TOKEN. One response can span several
    entries that repeat its `usage`, so requests are deduplicated by message id.
    """

    INTERESTING = ('"image"', '"usage"', "compact_boundary", '"custom-title"', '"ai-title"')

    def __init__(self, path: Path, since: float = 0.0):
        self.path = path
        self.since = since
        self.offset = 0
        self.context_tokens: int | None = None
        self.images: list[int] = []
        self.title: str | None = None
        self.requests = 0
        self.sent_tokens = 0
        self.sent_image_bytes = 0
        self._custom = False
        self._last_msg_id: str | None = None

    def restart_count(self, since: float) -> None:
        """Forget the requests counted so far; count from `since` on."""
        self.since = since
        self.requests = self.sent_tokens = self.sent_image_bytes = 0

    def next_request_bytes(self) -> float | None:
        """Estimated upload of the next request: context plus images."""
        if self.context_tokens is None:
            return None
        return self.context_tokens * BYTES_PER_TOKEN + sum(self.images) * IMAGE_GZIP_RATIO

    def poll(self) -> None:
        try:
            with self.path.open("rb") as f:
                f.seek(self.offset)
                chunk = f.read()
        except OSError:
            return
        end = chunk.rfind(b"\n")
        if end < 0:
            return  # only a partial line so far
        self.offset += end + 1
        for raw in chunk[:end].split(b"\n"):
            line = raw.decode("utf-8", errors="replace")
            if not any(tag in line for tag in self.INTERESTING):
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict):
                self._apply(obj)

    def _apply(self, obj: dict) -> None:
        t = obj.get("type")
        if t == "custom-title" and isinstance(obj.get("customTitle"), str):
            self.title, self._custom = obj["customTitle"], True
            return
        if t == "ai-title" and isinstance(obj.get("aiTitle"), str):
            if not self._custom:
                self.title = obj["aiTitle"]
            return
        if obj.get("isSidechain"):
            return
        if obj.get("subtype") == "compact_boundary":
            self.images = []
            return
        msg = obj.get("message")
        if not isinstance(msg, dict):
            return
        if t == "user":
            self.images.extend(_image_bytes(msg.get("content")))
        elif t == "assistant" and isinstance(msg.get("usage"), dict):
            u = msg["usage"]
            self.context_tokens = sum(
                u.get(k) or 0 for k in
                ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            msg_id = msg.get("id")
            if msg_id != self._last_msg_id and _epoch(obj.get("timestamp")) >= self.since:
                self.requests += 1
                self.sent_tokens += self.context_tokens
                self.sent_image_bytes += sum(self.images)
            self._last_msg_id = msg_id


def _epoch(ts) -> float:
    """An ISO-8601 transcript timestamp as epoch seconds; 0 if absent or bad."""
    if not isinstance(ts, str):
        return 0.0
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


# --- accounting -------------------------------------------------------------


@dataclass
class Counter:
    """Totals since start, plus the recent ticks that rolling rates need.

    Only ticks that moved bytes are kept, and only for the longest window,
    so an idle counter holds nothing.
    """
    total_in: int = 0
    total_out: int = 0
    _tick_in: int = 0
    _tick_out: int = 0
    _ticks: collections.deque = field(default_factory=collections.deque)

    def add(self, d_in: int, d_out: int) -> None:
        self.total_in += d_in
        self.total_out += d_out
        self._tick_in += d_in
        self._tick_out += d_out

    def close_tick(self, now: float, seconds: float) -> None:
        if self._tick_in or self._tick_out:
            self._ticks.append((now, max(seconds, 1e-6), self._tick_in, self._tick_out))
            self._tick_in = self._tick_out = 0
        while self._ticks and self._ticks[0][0] <= now - max(RATE_WINDOWS + (PEAK_WINDOW,)):
            self._ticks.popleft()

    def rate(self, window: float, now: float, span: float) -> tuple[float, float]:
        """(in, out) bytes/s over the last `window` seconds.

        `span` is how long the monitor has been counting. Early on, dividing
        by the whole window would understate the rate, so the divisor is
        whichever is shorter.
        """
        seconds = max(min(window, span), 1e-6)
        recent = [t for t in self._ticks if t[0] > now - window]
        return sum(t[2] for t in recent) / seconds, sum(t[3] for t in recent) / seconds

    def peak(self, now: float) -> tuple[float, float]:
        """(in, out) of the busiest single tick in the last PEAK_WINDOW seconds."""
        recent = [t for t in self._ticks if t[0] > now - PEAK_WINDOW]
        return (max((t[2] / t[1] for t in recent), default=0.0),
                max((t[3] / t[1] for t in recent), default=0.0))

    @property
    def total(self) -> int:
        return self.total_in + self.total_out


@dataclass
class Session:
    pid: int
    label: str = ""
    project: str = ""
    session_id: str | None = None
    alive: bool = True
    traffic: Counter = field(default_factory=Counter)
    api_bytes: int = 0
    api_out: int = 0
    children: dict[str, Counter] = field(default_factory=dict)
    watcher: TranscriptWatcher | None = None

    @property
    def title(self) -> str:
        if self.label:
            return self.label
        if self.watcher and self.watcher.title:
            return self.watcher.title
        return "(untitled)"


class Monitor:
    """Everything the screen shows, updated one nettop block at a time."""

    def __init__(self, sessions_dir: Path | None = None,
                 projects_dir: Path | None = None, api_ips: set[str] | None = None):
        self.sessions_dir = sessions_dir or claudeutils.CLAUDE_SESSIONS
        self.projects_dir = projects_dir or claudeutils.CLAUDE_PROJECTS
        self.api_ips = set(api_ips or API_FALLBACK_IPS)
        self.tracker = FlowTracker()
        self.sessions: dict[int, Session] = {}
        self.others: dict[str, Counter] = {}
        self.other_total = Counter()
        self.claude_total = Counter()
        self.tunnelled = Counter()
        self.unseen = Counter()  # bytes from connections nettop never showed
        self.tunnel_ips: set[str] = set()  # refreshed by the caller
        self.owner: dict[int, int] = {}   # sticky pid -> session pid
        self.names: dict[int, str] = {}   # sticky pid -> last good ps name
        self.started = time.time()
        self.counting_since = self.started  # moves on reset
        self.first_block: float | None = None
        self.last_block: float | None = None

    # The process table and registry are passed in so tests drive them.
    def ingest(self, block: list[ProcSample], ps: dict[int, tuple[int, str]],
               registry: dict[int, dict], now: float) -> None:
        self._sync_sessions(registry, ps)
        for pid in ps:  # learn owners while children are alive (sticky)
            self._owner_of(pid, ps)
        for proc in block:
            if (VERSION_NAME_RE.match(proc.name) and proc.pid not in self.sessions):
                self.sessions[proc.pid] = Session(proc.pid, label=UNREGISTERED)
        for d in self.tracker.update(block):
            if d.kind != "internet":
                continue
            if d.local in self.tunnel_ips:
                # Sent from a tunnel interface: the tunnel's own process sends
                # these bytes again, encrypted, so they appear twice on screen.
                self.tunnelled.add(d.d_in, d.d_out)
            if d.unseen:
                self.unseen.add(d.d_in, d.d_out)
            owner = self._owner_of(d.pid, ps)
            name = self._name_of(d.pid, ps, d.name)
            if owner is None:
                self.others.setdefault(name, Counter()).add(d.d_in, d.d_out)
                self.other_total.add(d.d_in, d.d_out)
                continue
            s = self.sessions[owner]
            s.traffic.add(d.d_in, d.d_out)
            self.claude_total.add(d.d_in, d.d_out)
            if d.remote in self.api_ips:
                s.api_bytes += d.d_in + d.d_out
                s.api_out += d.d_out
            if d.pid != owner:
                s.children.setdefault(name, Counter()).add(d.d_in, d.d_out)
        if self.first_block is None:
            self.first_block = now  # the baseline: counting starts here
        elapsed = now - self.last_block if self.last_block else 1.0
        self.last_block = now
        for c in self._counters():
            c.close_tick(now, elapsed)
        for s in self.sessions.values():
            if s.watcher:
                s.watcher.poll()

    def reset(self, now: float) -> None:
        """Zero every total and rate, as if the monitor had just started.

        Flow baselines and pid ownership are kept, since they describe the
        connections and processes, not what was counted. Ended sessions and
        idle other processes are dropped, because zeroed they say nothing.
        """
        self.counting_since = now
        # Rates are measured from the last block ingested, not from `now`:
        # a block already queued when the key was pressed carries deltas
        # since that block, and dividing them by the milliseconds since `now`
        # would show a spike of tens of MB/s.
        self.first_block = self.last_block or now
        self.claude_total, self.other_total = Counter(), Counter()
        self.tunnelled, self.unseen = Counter(), Counter()
        self.others = {}
        self.sessions = {pid: s for pid, s in self.sessions.items() if s.alive}
        # An exited child may still map to a dropped session; its last bytes
        # would then look up a session that is gone.
        self.owner = {pid: o for pid, o in self.owner.items() if o in self.sessions}
        for s in self.sessions.values():
            s.traffic, s.children = Counter(), {}
            s.api_bytes = s.api_out = 0
            if s.watcher:
                s.watcher.restart_count(now)

    def span(self, now: float) -> float:
        """Seconds of traffic counted so far (since the baseline block)."""
        return now - self.first_block if self.first_block else 0.0

    def measured_bytes_per_token(self) -> tuple[float, int] | None:
        """(upload bytes per context token, requests seen) since start.

        API upload over the context tokens of the requests the transcripts
        recorded, counting only sessions that carried no images. Subtracting
        an *estimated* image share was tried first: when images are 90% of
        the bytes, a small error in that estimate swamps the token signal (a
        live run read 5.01 where the transcripts implied about 1.2). Only
        sessions with a transcript count, for bytes as well as tokens; an
        unregistered `claude -p` would otherwise inflate the ratio. Requests
        absent from a main transcript (subagents, title generation,
        compaction) still upload, so this reads somewhat high.
        """
        clean = [s for s in self.sessions.values()
                 if s.watcher and s.watcher.sent_tokens and not s.watcher.sent_image_bytes]
        tokens_sent = sum(s.watcher.sent_tokens for s in clean)
        if not tokens_sent:
            return None
        uploaded = sum(s.api_out for s in clean)
        return uploaded / tokens_sent, sum(s.watcher.requests for s in clean)

    def _counters(self):
        yield self.other_total
        yield self.claude_total
        yield self.tunnelled
        yield self.unseen
        yield from self.others.values()
        for s in self.sessions.values():
            yield s.traffic
            yield from s.children.values()

    def _sync_sessions(self, registry: dict[int, dict], ps: dict) -> None:
        for pid, rec in registry.items():
            if ps and pid not in ps:
                continue  # stale file left by a crash
            s = self.sessions.setdefault(pid, Session(pid))
            if s.label == UNREGISTERED:
                s.label = ""
            s.alive = True
            name = rec.get("name")
            if isinstance(name, str) and name:
                s.label = name
            cwd = rec.get("cwd")
            if isinstance(cwd, str):
                s.project = Path(cwd).name or cwd
            sid = rec.get("sessionId")
            if isinstance(sid, str) and sid != s.session_id:
                s.session_id, s.watcher = sid, None  # /clear: follow the new transcript
            if s.watcher is None and s.session_id:
                # Retried every tick: a new session's transcript appears late.
                paths = claudeutils.transcripts_for(s.session_id, self.projects_dir)
                s.watcher = TranscriptWatcher(paths[0], self.counting_since) if paths else None
        for pid, s in self.sessions.items():
            if ps and pid not in ps:
                s.alive = False

    def _name_of(self, pid: int, ps: dict, nettop_name: str) -> str:
        """A process's display name, stable across its exit.

        nettop truncates names to 15 characters, so ps's is preferred. But ps
        reports an exiting process as `(name)` and a zombie as `<defunct>`,
        and the first version used those verbatim: one IDrive helper became
        two rows, `idrive_ver_001` and `(idrive_ver_001)`, and a curl
        download split between `curl` and `<defunct>`. So the parentheses
        are unwrapped, and the last good name is remembered for when ps no
        longer has one.
        """
        name = ps.get(pid, (0, ""))[1]
        if name.startswith("(") and name.endswith(")"):
            name = name[1:-1]
        if name and name != "<defunct>":
            self.names[pid] = name
            return name
        return self.names.get(pid) or nettop_name

    def _owner_of(self, pid: int, ps: dict) -> int | None:
        """The live session pid whose process tree `pid` belongs to, if any.

        Sticky: a child that has exited keeps the owner it was given while
        alive, since nettop may still report its last bytes. A pid that `ps`
        can see is always re-walked instead, because macOS recycles pids: a
        cached answer would credit an unrelated process that inherited a dead
        child's pid (or a dead session's) to that session. One nettop block
        can still name a pid born and gone between two `ps` snapshots; that
        one goes unattributed.
        """
        if pid not in ps:
            return self.owner.get(pid)
        p, hops = pid, 0
        while p and hops < 64:
            s = self.sessions.get(p)
            if s is not None and s.alive:
                self.owner[pid] = p
                return p
            p = ps.get(p, (0, ""))[0]
            hops += 1
        self.owner.pop(pid, None)
        return None


# --- interface counters and API addresses -----------------------------------


def default_interface() -> str | None:
    try:
        res = subprocess.run(["route", "-n", "get", "default"],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in res.stdout.splitlines():
        key, _, val = line.strip().partition(":")
        if key == "interface":
            return val.strip() or None
    return None


def interface_bytes(iface: str) -> tuple[int, int] | None:
    """(bytes in, bytes out) for `iface` from `netstat -ib`'s <Link#> row."""
    try:
        res = subprocess.run(["netstat", "-ib", "-I", iface],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = res.stdout.splitlines()
    if not lines:
        return None
    cols = lines[0].split()
    if "Ibytes" not in cols or "Obytes" not in cols:
        return None
    # Index from the end of the row: a utun (VPN) row leaves the Address
    # column blank, which shifts every field after it left by one.
    i_in, i_out = cols.index("Ibytes") - len(cols), cols.index("Obytes") - len(cols)
    for line in lines[1:]:
        parts = line.split()
        if len(parts) >= 3 and parts[2].startswith("<Link#"):
            try:
                return int(parts[i_in]), int(parts[i_out])
            except (ValueError, IndexError):
                return None
    return None


class InterfaceMeter:
    """Bytes through the default-route interface since the monitor started.

    The raw counter includes LAN traffic, so it is ground truth for "nothing
    escaped the per-flow count" only when the LAN is quiet. Re-resolved every
    tick: the default route moves between Ethernet and Wi-Fi.
    """

    def __init__(self):
        self.base: dict[str, tuple[int, int]] = {}
        self.iface: str | None = None
        self.since: tuple[int, int] | None = None

    def poll(self) -> None:
        self.iface = default_interface()
        if not self.iface:
            self.since = None
            return
        cur = interface_bytes(self.iface)
        if cur is None:
            self.since = None
            return
        base = self.base.setdefault(self.iface, cur)
        self.since = (cur[0] - base[0], cur[1] - base[1])

    def reset(self) -> None:
        """Re-baseline every interface at its next reading."""
        self.base = {}
        self.since = (0, 0) if self.since else None


TUNNEL_PREFIXES = ("utun", "ipsec", "ppp", "tun", "tap", "wg")


def tunnel_addresses(ifconfig_text: str | None = None) -> set[str]:
    """Every address assigned to a tunnel interface, from `ifconfig`.

    A flow whose local address is one of these went into a tunnel. Which
    process carries the tunnel out is not recoverable from nettop, ps or
    ifconfig, so the tunnelled bytes are reported, not subtracted.
    """
    if ifconfig_text is None:
        try:
            ifconfig_text = subprocess.run(["ifconfig"], capture_output=True, text=True,
                                           timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            return set()
    out, in_tunnel = set(), False
    for line in ifconfig_text.splitlines():
        if line and not line[0].isspace():
            in_tunnel = line.split(":", 1)[0].startswith(TUNNEL_PREFIXES)
            continue
        parts = line.split()
        if in_tunnel and len(parts) >= 2 and parts[0] in ("inet", "inet6"):
            out.add(parts[1].split("%", 1)[0])
    return out


def resolve_api_ips() -> set[str]:
    try:
        infos = socket.getaddrinfo(API_HOST, 443, proto=socket.IPPROTO_TCP)
    except OSError:
        return set()
    return {info[4][0] for info in infos}


# --- rendering --------------------------------------------------------------


def human(n: float) -> str:
    """Bytes as a short human string: 512 B, 12.3 KB, 4.1 MB."""
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} GB"


def tokens(n: int | None) -> str:
    if n is None:
        return "-"
    return f"{n / 1000:.0f}k" if n < 1_000_000 else f"{n / 1e6:.2f}M"


def hms(seconds: float) -> str:
    s = int(seconds)
    return f"{s // 3600:02d}:{s % 3600 // 60:02d}:{s % 60:02d}"


def fit(text: str, width: int) -> str:
    return text if len(text) <= width else text[: width - 1] + "…"


def short(n: float) -> str:
    """A byte count in at most 5 characters, for the dense rate columns."""
    if n < 0.5:
        return "0"
    for unit in ("", "K", "M", "G"):
        if n < 1000 or unit == "G":
            return f"{n:.0f}{unit}" if n >= 10 or not unit else f"{n:.1f}{unit}"
        n /= 1000
    return f"{n:.0f}G"


# Every traffic row -- sessions, children, other processes, totals -- shares
# one layout, so the rate and total columns line up down the whole screen.
NAME_W, PROJ_W, RATE_W = 26, 12, 5
TIERS = len(RATE_WINDOWS) + 1  # the averages plus the peak
TOTAL_FMT = "{:>8} {:>8}"
EXTRA_FMT = "{:>4} {:>5} {:>10} {:>6}"


def _tier_label(seconds: int) -> str:
    return f"{seconds}s" if seconds < 60 else f"{seconds // 60}m"


# "peak" alone did not say over what period; the window is in the label.
PEAK_LABEL = f"max{_tier_label(PEAK_WINDOW)}"


def _rate_cells(c: Counter, now: float, span: float, direction: int) -> str:
    """The TIERS rate cells for one direction (0 = in, 1 = out)."""
    vals = [c.rate(w, now, span)[direction] for w in RATE_WINDOWS]
    vals.append(c.peak(now)[direction])
    return " ".join(f"{short(v):>{RATE_W}}" for v in vals)


def traffic_row(name: str, project: str, c: Counter, now: float, span: float,
                extra: tuple[str, str, str, str] = ("", "", "", "")) -> str:
    return " ".join([
        f"{fit(name, NAME_W):<{NAME_W}}", f"{fit(project, PROJ_W):<{PROJ_W}}",
        _rate_cells(c, now, span, 1), " ", _rate_cells(c, now, span, 0),
        TOTAL_FMT.format(human(c.total_out), human(c.total_in)),
        EXTRA_FMT.format(*extra),
    ]).rstrip()


def header_rows(first: str) -> list[tuple[str, str]]:
    tiers = " ".join(f"{t:>{RATE_W}}" for t in
                     [_tier_label(w) for w in RATE_WINDOWS] + [PEAK_LABEL])
    group_w = TIERS * (RATE_W + 1) - 1
    lead = " " * (NAME_W + PROJ_W + 2)
    top = (lead + f"{'UP per second':^{group_w}}" + "   " + f"{'DOWN per second':^{group_w}}"
           + " " + f"{'TOTAL':^17}")
    cols = " ".join([
        f"{first:<{NAME_W}}", f"{'PROJECT' if first == 'SESSION' else '':<{PROJ_W}}",
        tiers, " ", tiers, TOTAL_FMT.format("UP", "DOWN"),
        EXTRA_FMT.format("API%", "CTX", "IMAGES", "NEXT") if first == "SESSION" else "",
    ]).rstrip()
    return [(top.rstrip(), "dim"), (cols, "bold")]


SORTS = ("total", "rate", "name")
KEY_HELP = (" keys:  s sort (total / 1m rate / name)   c child processes   "
            "o other processes   r reset totals   p pause   ? hide keys   q quit")


@dataclass
class View:
    """What the keys control. Display only: none of it changes the counting."""
    sort: str = "total"
    children: bool = True
    others: bool = True
    paused: bool = False
    help: bool = False


def handle_key(view: View, ch: str) -> str | None:
    """Apply one keypress to `view`.

    Returns 'quit' or 'reset' for the caller to act on, 'redraw' when only
    the view changed, or None for a key with no meaning.
    """
    ch = ch.lower()
    if ch == "q":
        return "quit"
    if ch == "r":
        return "reset"
    if ch == "s":
        view.sort = SORTS[(SORTS.index(view.sort) + 1) % len(SORTS)]
    elif ch == "c":
        view.children = not view.children
    elif ch == "o":
        view.others = not view.others
    elif ch == "p":
        view.paused = not view.paused
    elif ch == "?":
        view.help = not view.help
    else:
        return None
    return "redraw"


def _sort_key(view: View, name: str, c: Counter, now: float, span: float):
    if view.sort == "name":
        return name.lower()
    if view.sort == "rate":
        return -sum(c.rate(60, now, span))  # 1 min: the 5 s figure reshuffles every second
    return -c.total


def render(mon: Monitor, meter: InterfaceMeter, now: float, top: int,
           view: View | None = None) -> list[tuple[str, str]]:
    """The whole screen as (text, style) lines; style is '', 'bold' or 'dim'."""
    view = view or View()
    span = mon.span(now)
    lines: list[tuple[str, str]] = []
    add = lines.append
    add((f"claude-traffic-monitor   counting {hms(now - mon.counting_since)}   "
         "internet only (LAN and loopback excluded)", "bold"))
    if meter.iface and meter.since:
        add((f"interface {meter.iface} (raw, includes LAN):  "
             f"up {human(meter.since[1])}   down {human(meter.since[0])}", ""))
    else:
        add(("interface: no default route", "dim"))
    add(("", ""))
    lines.extend(header_rows("SESSION"))
    sessions = sorted(mon.sessions.values(), key=lambda s: (
        not s.alive, _sort_key(view, s.title, s.traffic, now, span), s.pid))
    for s in sessions:
        t, w = s.traffic, s.watcher
        api = f"{100 * s.api_bytes // t.total}" if t.total else "-"
        imgs = f"{len(w.images)}/{human(sum(w.images))}" if w and w.images else "-"
        nxt = w.next_request_bytes() if w else None
        extra = (api, tokens(w.context_tokens if w else None), imgs,
                 "-" if nxt is None else short(nxt))
        title = s.title if s.alive else f"{s.title} (ended)"
        add((traffic_row(title, s.project, t, now, span, extra), "" if s.alive else "dim"))
        if not view.children:
            continue  # their bytes stay in the session's row
        for name, c in sorted(s.children.items(), key=lambda kv: -kv[1].total):
            add((traffic_row(f"  └ {name}", "", c, now, span), "dim"))
    add((traffic_row("Claude total", "", mon.claude_total, now, span), "bold"))
    measured = mon.measured_bytes_per_token()
    if measured:
        ratio, n = measured
        add((f"upload per context token: {ratio:.2f} B measured over {n} requests "
             f"(NEXT assumes {BYTES_PER_TOKEN:.2f})", "dim"))
    add(("", ""))
    if not view.others:
        # Collapsed to one row under the session columns, which it lines up with.
        add((traffic_row("Other processes", f"{len(mon.others)} hidden",
                         mon.other_total, now, span), "bold"))
        _add_tunnel_note(add, mon, now, span)
        return lines
    lines.extend(header_rows("OTHER PROCESSES (internet)"))
    hot = sorted(mon.others.items(), key=lambda kv: _sort_key(view, kv[0], kv[1], now, span))
    for name, c in hot[:top]:
        add((traffic_row(name, "", c, now, span), ""))
    if len(hot) > top:
        add((f"  … and {len(hot) - top} more", "dim"))
    add((traffic_row("Everything else total", "", mon.other_total, now, span), "bold"))
    _add_tunnel_note(add, mon, now, span)
    return lines


def _add_tunnel_note(add, mon: Monitor, now: float, span: float) -> None:
    """Dim notes on the totals above them: what is in them twice, or by guess."""
    if mon.tunnelled.total:
        add((traffic_row("Tunnelled, in rows above", "sent twice",
                         mon.tunnelled, now, span), "dim"))
    if mon.unseen.total:
        add((traffic_row("Too brief to classify", "as internet",
                         mon.unseen, now, span), "dim"))


def status_lines(view: View) -> list[tuple[str, str]]:
    """The bottom of the screen: the key list when asked for, then the state."""
    # Each value is padded to its longest form, so toggling one does not
    # shift everything after it along the bar.
    sort_w = max(map(len, SORTS))
    state = [f"sort: {view.sort:<{sort_w}}",
             f"children: {'shown' if view.children else 'hidden':<6}",
             f"others: {'shown' if view.others else 'hidden':<6}"]
    state.append("? hides keys" if view.help else "? keys")
    state.append("q quit")
    if view.paused:
        state.append("PAUSED (p resumes)")  # last, so nothing before it moves
    status = (" " + "   ".join(state), "status")
    return [(KEY_HELP, "dim"), status] if view.help else [status]


# --- the live screen --------------------------------------------------------


def reader(proc: subprocess.Popen, out: queue.Queue) -> None:
    """Feed nettop's stream to the parser, queueing each completed block.

    The end marker is sent from `finally`: if this thread dies on its own,
    the main loop must hear about it. Otherwise the screen freezes on stale
    numbers with no error.
    """
    parser = NettopParser()
    try:
        for line in proc.stdout:
            block = parser.feed(line)
            if block is not None:
                out.put((time.time(), block))
    finally:
        out.put(None)


def run(stdscr, interval: int, top: int) -> str | None:
    curses.curs_set(0)
    try:
        # curses.wrapper starts color, which paints every cell white on black;
        # this keeps the terminal's own theme (Solarized Light included).
        curses.use_default_colors()
    except curses.error:
        pass
    stdscr.timeout(200)
    styles = {"": curses.A_NORMAL, "bold": curses.A_BOLD, "dim": curses.A_DIM,
              "status": curses.A_REVERSE}
    nettop = subprocess.Popen(
        ["nettop", "-L", "0", "-s", str(interval), "-x", "-n", "-J", "bytes_in,bytes_out"],
        # nettop truncates names at a byte count, which can split a UTF-8
        # character; a strict decode would kill the reader thread.
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    blocks: queue.Queue = queue.Queue()
    threading.Thread(target=reader, args=(nettop, blocks), daemon=True).start()
    mon = Monitor(api_ips=resolve_api_ips() | API_FALLBACK_IPS)
    meter = InterfaceMeter()
    view = View()
    api_checked = time.time()
    dirty = True
    try:
        while True:
            key = stdscr.getch()
            if key == curses.KEY_RESIZE:
                dirty = True
            elif 0 < key < 256:
                action = handle_key(view, chr(key))
                if action == "quit":
                    return None
                if action == "reset":
                    mon.reset(time.time())
                    meter.reset()
                # Any key redraws, so a view change while paused shows at once.
                dirty = dirty or action is not None
            while True:
                try:
                    item = blocks.get_nowait()
                except queue.Empty:
                    break
                if item is None:
                    return "lost the nettop stream (nettop exited or its output was unreadable)"
                stamp, block = item
                mon.tunnel_ips = tunnel_addresses()
                mon.ingest(block, process_table(), claudeutils.read_registry(mon.sessions_dir), stamp)
                meter.poll()
                dirty = dirty or not view.paused
            if time.time() - api_checked > API_REFRESH_SECONDS:
                mon.api_ips |= resolve_api_ips()
                api_checked = time.time()
            if dirty:
                draw(stdscr, render(mon, meter, time.time(), top, view),
                     status_lines(view), styles)
                dirty = False
    finally:
        nettop.kill()
        nettop.wait()


def draw(stdscr, lines: list[tuple[str, str]], footer: list[tuple[str, str]],
         styles: dict) -> None:
    """Paint `lines` from the top and pin `footer` to the bottom rows."""
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    body = max(height - len(footer), 0)
    placed = list(enumerate(lines[:body])) + [
        (height - len(footer) + i, item) for i, item in enumerate(footer)]
    for y, (text, style) in placed:
        if y < 0:
            continue
        attr = styles.get(style, curses.A_NORMAL)
        if style == "status":
            text = text.ljust(width - 1)  # a full-width bar, as in top
        try:
            stdscr.addnstr(y, 0, text, width - 1, attr)
        except curses.error:
            pass  # writing the bottom-right cell raises; harmless
    stdscr.refresh()


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        prog="claude-traffic-monitor",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Live, top-like view of network traffic per Claude Code session, "
                    "counted since the monitor started.",
        epilog="Counts internet traffic only: loopback and LAN flows are excluded.\n"
               "Totals start at zero when the monitor starts and are kept in memory only.\n"
               "Requires macOS nettop. Press ? on the screen for its keys.",
    )
    parser.add_argument("-s", "--interval", type=int, default=1, metavar="SECONDS",
                        help="Sampling interval in whole seconds (default: 1)")
    parser.add_argument("--top", type=int, default=8, metavar="N",
                        help="How many non-Claude processes to list (default: 8)")
    add_version_arg(parser)
    args = parser.parse_args(argv)
    if args.interval < 1:
        error("--interval must be at least 1 second")
    if args.top < 0:
        error("--top must not be negative")
    if not sys.stdout.isatty():
        error("needs a terminal (it redraws the screen like top)")
    if shutil.which("nettop") is None:
        error("nettop not found (macOS only)")
    locale.setlocale(locale.LC_ALL, "")
    try:
        problem = curses.wrapper(run, args.interval, args.top)
    except KeyboardInterrupt:
        problem = None
    except Exception as exc:  # repo convention: no top-level tracebacks
        problem = f"internal error: {type(exc).__name__}: {exc}"
    if problem:
        error(problem)


if __name__ == "__main__":
    main()
