#!/usr/bin/env python3
"""List recent Claude Code sessions in a git-log-style view.

Defaults to sessions for the current project (cwd). -g/--global spans every
project under ~/.claude/projects. Newest first by file mtime.
"""
from __future__ import annotations

import argparse
import sys
from datetime import datetime, timezone
from pathlib import Path

from bdutils import add_version_arg, error, paged_output
from claudeutils import (
    CLAUDE_PROJECTS,
    SessionMeta,
    find_project_dir,
    list_sessions,
    project_label,
)


def _parse_iso(ts: str | None) -> datetime | None:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def _humanize_delta(seconds: float) -> str:
    """Compact relative-time string: '3m', '5h', '2d', '3w', '4mo', '1y'."""
    s = int(seconds)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    if s < 7 * 86400:
        return f"{s // 86400}d"
    if s < 30 * 86400:
        return f"{s // (7 * 86400)}w"
    if s < 365 * 86400:
        return f"{s // (30 * 86400)}mo"
    return f"{s // (365 * 86400)}y"


def _humanize_span(seconds: float) -> str:
    """Active-span string: '5m', '1h12m', '2d3h'. Empty for spans < 1 min."""
    s = int(seconds)
    if s < 60:
        return ""
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        h, rem = divmod(s, 3600)
        m = rem // 60
        return f"{h}h{m}m" if m else f"{h}h"
    d, rem = divmod(s, 86400)
    h = rem // 3600
    return f"{d}d{h}h" if h else f"{d}d"


def render_range(meta: SessionMeta, now: datetime) -> str:
    """'2026-05-27 09:11 → 14:32  (3h ago, 5h21m active)' or graceful fallback."""
    first = _parse_iso(meta.first_ts)
    last = _parse_iso(meta.last_ts)
    if first is None and last is None:
        # Fallback: file mtime when the jsonl has no timestamped entries.
        mtime = datetime.fromtimestamp(meta.jsonl.stat().st_mtime).astimezone()
        ago = _humanize_delta((now - mtime.astimezone(timezone.utc)).total_seconds())
        return f"{mtime.strftime('%Y-%m-%d %H:%M')}  ({ago} ago, mtime)"

    first_local = (first or last).astimezone()
    last_local = (last or first).astimezone()
    ago = _humanize_delta((now - last_local.astimezone(timezone.utc)).total_seconds())
    same_day = first_local.date() == last_local.date()
    start_str = first_local.strftime("%Y-%m-%d %H:%M")
    end_str = last_local.strftime("%H:%M" if same_day else "%Y-%m-%d %H:%M")
    span = _humanize_span((last_local - first_local).total_seconds())
    tail = f"({ago} ago, {span} active)" if span else f"({ago} ago)"
    if first_local == last_local:
        return f"{start_str}  {tail}"
    return f"{start_str} → {end_str}  {tail}"


# Fixed column widths for --oneline (data + matching headers).
ONELINE_ID_W = 8          # uuid prefix is always 8 hex chars
ONELINE_STARTED_W = 16    # "YYYY-MM-DD HH:MM"
ONELINE_AGE_W = 8         # "{:>4} ago" → always 8


def _oneline_row(meta: SessionMeta, now: datetime, show_project: bool,
                 counts_w: int, project_w: int) -> str:
    short = meta.jsonl.stem.split("-")[0]
    first = _parse_iso(meta.first_ts)
    last = _parse_iso(meta.last_ts)
    # STARTED column shows session start (first_ts). Falls back to last_ts
    # then file mtime if the jsonl has no timestamped entries.
    if first is not None:
        started_local = first.astimezone()
    elif last is not None:
        started_local = last.astimezone()
    else:
        started_local = datetime.fromtimestamp(meta.jsonl.stat().st_mtime).astimezone()
    # AGE is independent — always "time since last activity", i.e. freshness.
    age_ref = (last or first).astimezone() if (last or first) else started_local
    ago = _humanize_delta((now - age_ref.astimezone(timezone.utc)).total_seconds())
    counts = f"{meta.human_prompts}p/{meta.assistant_turns}r"
    bits = [
        f"{short:<{ONELINE_ID_W}}",
        f"{started_local.strftime('%Y-%m-%d %H:%M'):<{ONELINE_STARTED_W}}",
        f"{ago + ' ago':<{ONELINE_AGE_W}}",
        f"{counts:<{counts_w}}",
    ]
    if show_project:
        bits.append(f"{project_label(meta.jsonl, meta.cwd):<{project_w}}")
    bits.append(meta.title)
    return "  ".join(bits)


def _oneline_header(show_project: bool, counts_w: int, project_w: int) -> str:
    bits = [
        f"{'ID':<{ONELINE_ID_W}}",
        f"{'STARTED':<{ONELINE_STARTED_W}}",
        f"{'AGE':<{ONELINE_AGE_W}}",
        f"{'COUNTS':<{counts_w}}",
    ]
    if show_project:
        bits.append(f"{'PROJECT':<{project_w}}")
    bits.append("TITLE")
    return "  ".join(bits)


def render_oneline_block(sessions: list[SessionMeta], now: datetime,
                         show_project: bool) -> list[str]:
    """Header + one row per session, with columns sized to the data."""
    counts_strs = [f"{m.human_prompts}p/{m.assistant_turns}r" for m in sessions]
    counts_w = max(len("COUNTS"), max((len(s) for s in counts_strs), default=0))
    project_w = 0
    if show_project:
        project_w = max(
            len("PROJECT"),
            max((len(project_label(m.jsonl, m.cwd)) for m in sessions), default=0),
        )
    lines = [_oneline_header(show_project, counts_w, project_w)]
    lines.extend(
        _oneline_row(m, now, show_project, counts_w, project_w) for m in sessions
    )
    return lines


def render_block(meta: SessionMeta, now: datetime, show_project: bool) -> list[str]:
    lines = [meta.jsonl.stem]
    if show_project:
        lines.append(f"  {project_label(meta.jsonl, meta.cwd)}")
    lines.append(f"  {render_range(meta, now)}")
    p_word = "prompt" if meta.human_prompts == 1 else "prompts"
    r_word = "reply" if meta.assistant_turns == 1 else "replies"
    lines.append(
        f"  {meta.human_prompts} {p_word} / {meta.assistant_turns} {r_word}"
    )
    lines.append(f"  {meta.title}")
    return lines


def _duration_secs(meta: SessionMeta) -> float:
    """Session active span in seconds. 0 when timestamps are unavailable."""
    first = _parse_iso(meta.first_ts)
    last = _parse_iso(meta.last_ts)
    if first is None or last is None:
        return 0.0
    return (last - first).total_seconds()


# Sort keys recognised by --sort. Each maps to a callable that extracts the
# comparison value from a SessionMeta. Strings compare lexically; ints/floats
# numerically. Missing timestamps fall through as empty strings, which sort
# before any real ISO date.
SORT_KEYS = {
    "started":  lambda m: m.first_ts or "",
    "last":     lambda m: m.last_ts or "",
    "duration": _duration_secs,
    "prompts":  lambda m: m.human_prompts,
    "replies":  lambda m: m.assistant_turns,
    "turns":    lambda m: m.human_prompts + m.assistant_turns,
    "title":    lambda m: m.title.lower(),
    "project":  lambda m: project_label(m.jsonl, m.cwd).lower(),
    "id":       lambda m: m.jsonl.stem,
}


def parse_sort(spec: str) -> list[tuple[str, bool]]:
    """Parse '-started,title' into [('started', True), ('title', False)]."""
    keys: list[tuple[str, bool]] = []
    for token in spec.split(","):
        token = token.strip()
        if not token:
            continue
        desc = token.startswith("-")
        name = token.lstrip("-+")
        if name not in SORT_KEYS:
            error(
                f"--sort: unknown key {name!r} "
                f"(valid: {', '.join(sorted(SORT_KEYS))})"
            )
        keys.append((name, desc))
    return keys


def apply_sort(sessions: list[SessionMeta],
               keys: list[tuple[str, bool]]) -> list[SessionMeta]:
    """Stable multi-key sort. Later keys are primary, so apply in reverse."""
    result = list(sessions)
    for name, desc in reversed(keys):
        result.sort(key=SORT_KEYS[name], reverse=desc)
    return result


def apply_match(sessions: list[SessionMeta], pattern: str) -> list[SessionMeta]:
    """Case-insensitive substring match on title OR full uuid."""
    needle = pattern.lower()
    return [
        m for m in sessions
        if needle in m.title.lower() or needle in m.jsonl.stem.lower()
    ]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="List recent Claude Code sessions, git-log style.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  claude-session-list                   Sessions for cwd's project\n"
            "  claude-session-list -g                Every project\n"
            "  claude-session-list -n 5              Last 5 only\n"
            "  claude-session-list --oneline         One row per session\n"
            "  claude-session-list -q                UUIDs only, pipe-friendly\n"
            "  claude-session-list -a                Include truly-empty (/clear ghosts)\n"
            "  claude-session-list --min-prompts 3   Real conversations only\n"
            "  claude-session-list -m bd-view        Sessions whose title/uuid contains 'bd-view'\n"
            "  claude-session-list --sort=-turns     Biggest conversations first\n"
            "  claude-session-list --sort=title      Alphabetical by title\n"
            "  claude --resume $(claude-session-list -q | head -1)\n"
            "\n"
            "Session data lives under ~/.claude/projects/<mangled-cwd>/<uuid>.jsonl.\n"
            "Newest first by file mtime. Counts show 'Np/Mr' = human prompts /\n"
            "assistant replies; entries that contain only slash-command, system-\n"
            "reminder, or bash-shortcut wrappers are NOT counted as human prompts\n"
            "(this is how /clear-ghost sessions register as 0p/0r and are hidden\n"
            "by the default filter). Timestamps come from the first and last\n"
            "entry in the jsonl; falls back to file mtime if absent.\n"
        ),
    )
    parser.add_argument(
        "-g", "--global", dest="global_", action="store_true",
        help="List sessions across all projects (default: cwd only)",
    )
    parser.add_argument(
        "-n", "--limit", type=int, default=0,
        help="Maximum sessions to show (default: 0 = unlimited)",
    )
    parser.add_argument(
        "-s", "--sort", default=None, metavar="KEYS",
        help=(
            "Comma-separated sort keys; prefix with '-' for descending "
            "(e.g., '-started,title'). Default: newest activity first. "
            "Use '--sort=-key' (with '=') when the first key is descending, "
            "so argparse doesn't treat it as a flag. "
            "Keys: " + ", ".join(sorted(SORT_KEYS))
        ),
    )
    parser.add_argument(
        "-m", "--match", default=None, metavar="PATTERN",
        help="Show only sessions whose title or UUID contains PATTERN "
             "(case-insensitive substring match)",
    )
    filter_grp = parser.add_mutually_exclusive_group()
    filter_grp.add_argument(
        "-a", "--all", dest="show_all", action="store_true",
        help="Show every session, including truly-empty ones "
             "(default hides sessions with no human prompts AND no replies)",
    )
    filter_grp.add_argument(
        "--min-prompts", type=int, default=None, metavar="N",
        help="Only show sessions with at least N human prompts "
             "(stricter than the default empty-session filter)",
    )
    grp = parser.add_mutually_exclusive_group()
    grp.add_argument(
        "--oneline", action="store_true",
        help="Single-row output: uuid-prefix, last ts, age, Np/Mr, title",
    )
    grp.add_argument(
        "-q", "--quiet", action="store_true",
        help="Print only session UUIDs (one per line, pipe-friendly)",
    )
    parser.add_argument(
        "--no-pager", action="store_true",
        help="Write directly to stdout; skip the pager ($PAGER or less -FRX)",
    )
    add_version_arg(parser)
    args = parser.parse_args()

    if args.limit < 0:
        error("--limit must be >= 0 (0 means unlimited)")
    if args.min_prompts is not None and args.min_prompts < 0:
        error("--min-prompts must be >= 0")
    if not CLAUDE_PROJECTS.is_dir():
        error(f"no such directory: {CLAUDE_PROJECTS}")

    sort_keys = parse_sort(args.sort) if args.sort else []

    if args.global_:
        sessions = list_sessions()
        show_project = True
    else:
        cwd = Path.cwd().resolve()
        pdir = find_project_dir(cwd)
        if pdir is None:
            error(f"no Claude sessions recorded for {cwd} (try --global)")
        sessions = list_sessions(pdir)
        show_project = False

    # Filter order: --match narrows first (user-expressed interest), then the
    # empty/min-prompts filter, then sort, then limit. The hidden_count footer
    # reflects what the empty filter removed from the match-narrowed set.
    if args.match:
        sessions = apply_match(sessions, args.match)

    hidden_count = 0
    if not args.show_all:
        before = len(sessions)
        if args.min_prompts is not None:
            sessions = [s for s in sessions if s.human_prompts >= args.min_prompts]
        else:
            sessions = [s for s in sessions if not s.is_empty]
        hidden_count = before - len(sessions)

    if sort_keys:
        sessions = apply_sort(sessions, sort_keys)

    if args.limit > 0:
        sessions = sessions[:args.limit]

    if not sessions:
        if hidden_count:
            print(
                f"no sessions to show ({hidden_count} hidden by filter; "
                "use --all to include them)"
            )
        else:
            print("no sessions found")
        return 0

    now = datetime.now(timezone.utc)
    no_pager = True if args.quiet else args.no_pager
    with paged_output(no_pager=no_pager) as out:
        if args.quiet:
            for meta in sessions:
                print(meta.jsonl.stem, file=out)
        elif args.oneline:
            for line in render_oneline_block(sessions, now, show_project):
                print(line, file=out)
        else:
            for i, meta in enumerate(sessions):
                if i:
                    print(file=out)
                for line in render_block(meta, now, show_project):
                    print(line, file=out)
        out.flush()

    # Hint about filtered sessions — stderr keeps -q pipes clean and the
    # block/oneline output uncluttered.
    if hidden_count and not args.quiet:
        word = "session" if hidden_count == 1 else "sessions"
        sys.stderr.write(
            f"({hidden_count} empty {word} hidden; use --all to show)\n"
        )

    return 0


if __name__ == "__main__":
    sys.exit(main())
