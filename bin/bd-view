#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["rich", "markdown-it-py"]
# ///
"""Pretty-print a beads issue with rendered Markdown."""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import textwrap

from bdutils import add_version_arg, error, format_priority, format_ts, paged_output, warn

try:
    from markdown_it import MarkdownIt
    from rich.console import Console
    from rich.markdown import Heading, Markdown as _RichMarkdown
    from rich.table import Table
    from rich.text import Text
    from rich.theme import Theme
    HAVE_RICH = True

    class _PlainHeading(Heading):
        """Render H1 inline like H2/H3 instead of inside a HEAVY box panel."""
        def __rich_console__(self, console, options):
            text = self.text
            text.justify = "left"
            if self.tag in ("h1", "h2"):
                yield Text("")
            yield text

    class Markdown(_RichMarkdown):
        """Markdown renderer with quieter styling for beads prose.

        - raw HTML disabled (placeholder text like '<id>' is preserved
          instead of being eaten by markdown-it's default html=True);
        - H1 renders as plain bold text instead of a HEAVY box panel.
        """
        elements = {**_RichMarkdown.elements, "heading_open": _PlainHeading}

        def __init__(self, markup: str, **kwargs) -> None:
            super().__init__(markup, **kwargs)
            parser = (
                MarkdownIt("commonmark", {"html": False})
                .enable("strikethrough")
                .enable("table")
            )
            self.parsed = parser.parse(markup)

    # Quieter theme overrides (rich defaults are noisier than we want):
    #  - inline `code` drops the dark filled background (was 'bold cyan on black')
    #  - h2 drops the underline (was 'bold underline')
    QUIET_THEME = Theme({
        "markdown.code": "cyan",
        "markdown.h2": "bold",
    })
except ImportError:
    HAVE_RICH = False


def with_hard_breaks(text: str) -> str:
    """Append two trailing spaces to non-empty lines so single newlines
    render as visible line breaks (CommonMark otherwise collapses them to
    spaces). Lines inside fenced code blocks are left untouched."""
    out: list[str] = []
    in_fence = False
    for line in text.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("```") or stripped.startswith("~~~"):
            in_fence = not in_fence
            out.append(line)
            continue
        if in_fence or not line.strip() or line.endswith("  "):
            out.append(line)
        else:
            out.append(line + "  ")
    return "\n".join(out)


STATUS_GLYPH = {
    "open": "○",
    "in_progress": "◐",
    "blocked": "●",
    "deferred": "❄",
    "closed": "✓",
    "pinned": "📌",
    "hooked": "◇",
}

STATUS_STYLE = {
    "open": "yellow",
    "in_progress": "cyan",
    "blocked": "red",
    "deferred": "blue",
    "closed": "green",
    "pinned": "magenta",
    "hooked": "magenta",
}

# Dependency edges come back from `bd dep list` tagged with a dependency_type
# ('blocks', 'parent-child', and eight rarer kinds). The heading depends on both
# the type and which way we asked: '--direction=down' lists what this bead points
# at, '--direction=up' what points back. Types not in this table still render,
# under their raw name (see dep_heading) -- nothing is silently dropped.
DEP_HEADINGS = {
    ("down", "parent-child"): "Parent:",
    ("up", "parent-child"): "Children:",
    ("down", "blocks"): "Depends on:",
    ("up", "blocks"): "Blocks:",
    ("down", "tracks"): "Tracks:",
    ("up", "tracks"): "Tracked by:",
    ("down", "discovered-from"): "Discovered from:",
    ("up", "discovered-from"): "Discovered:",
    ("down", "caused-by"): "Caused by:",
    ("up", "caused-by"): "Caused:",
    ("down", "validates"): "Validates:",
    ("up", "validates"): "Validated by:",
    ("down", "supersedes"): "Supersedes:",
    ("up", "supersedes"): "Superseded by:",
    ("down", "related"): "Related:",
    ("up", "related"): "Related to:",
    ("down", "relates-to"): "Relates to:",
    ("up", "relates-to"): "Related from:",
    ("down", "until"): "Until:",
    ("up", "until"): "Until (inbound):",
}

# Order the dependency groups are printed in; anything else follows, sorted.
DEP_TYPE_ORDER = ["parent-child", "blocks"]

# Every top-level key of `bd show --json` that some renderer above accounts for.
# Whatever is left over lands in the trailing 'Other Fields' section, so a bead
# field bd grows later shows up unprompted instead of vanishing.
RENDERED_KEYS = frozenset({
    "id", "title", "status", "priority", "issue_type",
    "owner", "assignee", "created_by",
    "created_at", "started_at", "updated_at", "closed_at", "defer_until",
    "close_reason", "external_ref", "spec_id", "labels", "metadata",
    "description", "design", "notes", "acceptance_criteria",
    "parent", "dependencies",
})

# Counts that duplicate the rendered dependency/comment lists.
IGNORED_KEYS = frozenset({"dependency_count", "dependent_count", "comment_count"})


def dep_heading(direction: str, dep_type: str) -> str:
    """Heading for one dependency group; falls back to the raw type name."""
    known = DEP_HEADINGS.get((direction, dep_type))
    if known:
        return known
    suffix = "" if direction == "down" else " (inbound)"
    return f"{dep_type or 'related'}{suffix}:"


def group_deps(deps: list[dict], dependents: list[dict],
               ) -> list[tuple[str, str, list[dict]]]:
    """Bucket both directions' edges by dependency_type.

    Returns (direction, dep_type, items) groups ordered the way `bd show`
    presents them -- parent, children, depends-on, blocks -- with any other
    type following alphabetically. Ordering is by type first (not direction),
    so the two halves of a relationship stay adjacent."""
    groups: dict[tuple[str, str], list[dict]] = {}
    for direction, edges in (("down", deps), ("up", dependents)):
        for d in edges:
            key = (direction, d.get("dependency_type") or "")
            groups.setdefault(key, []).append(d)

    def sort_key(key: tuple[str, str]) -> tuple[int, str, int]:
        direction, dep_type = key
        rank = (DEP_TYPE_ORDER.index(dep_type) if dep_type in DEP_TYPE_ORDER
                else len(DEP_TYPE_ORDER))
        # 'down' first within a type: Parent before Children, Depends on before
        # Blocks. The type name only breaks ties among the unranked types.
        return (rank, "" if rank < len(DEP_TYPE_ORDER) else dep_type,
                0 if direction == "down" else 1)

    return [(d, t, groups[(d, t)]) for d, t in sorted(groups, key=sort_key)]


def has_parent_edge(deps: list[dict]) -> bool:
    return any(d.get("dependency_type") == "parent-child" for d in deps)


def flatten_pairs(mapping: dict) -> list[tuple[str, str]]:
    """A flat dict (the bead's 'metadata') as ordered label/value lines."""
    return [(str(k), v if isinstance(v, str) else json.dumps(v))
            for k, v in mapping.items()]


def flatten_extra(key: str, value: object) -> list[tuple[str, str]]:
    """Render a leftover JSON field as label/value line(s).

    Dicts expand one level ('metadata.branch'); everything else is stringified,
    with non-scalars falling back to compact JSON."""
    if isinstance(value, dict):
        return [(f"{key}.{k}", v if isinstance(v, str) else json.dumps(v))
                for k, v in value.items()]
    if isinstance(value, list):
        if all(isinstance(v, (str, int, float)) for v in value):
            return [(key, ", ".join(str(v) for v in value))]
        return [(key, json.dumps(value))]
    if isinstance(value, str):
        return [(key, value)]
    return [(key, json.dumps(value))]


def extra_fields(issue: dict) -> list[tuple[str, str]]:
    """Fields present in the bead JSON that no other renderer claims."""
    out: list[tuple[str, str]] = []
    for key in sorted(issue):
        if key in RENDERED_KEYS or key in IGNORED_KEYS:
            continue
        value = issue[key]
        if value in (None, "", [], {}):
            continue
        out.extend(flatten_extra(key, value))
    return out


def run_bd_json(args: list[str]) -> object:
    cmd = ["bd"] + args
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        error("'bd' not found on PATH")
    if result.returncode != 0:
        msg = ""
        try:
            payload = json.loads(result.stdout)
            if isinstance(payload, dict) and "error" in payload:
                msg = payload["error"]
        except json.JSONDecodeError:
            pass
        if not msg and result.stderr.strip():
            msg = result.stderr.strip().splitlines()[0]
        if not msg:
            msg = f"bd {' '.join(args)} failed (exit {result.returncode})"
        error(msg)
    if not result.stdout.strip():
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        error(f"could not parse bd output as JSON: {exc}")


def fetch_issue(issue_id: str) -> dict:
    data = run_bd_json(["show", issue_id, "--long", "--json"])
    if not isinstance(data, list) or not data:
        error(f"no data returned for {issue_id}")
    return data[0]


def fetch_deps(issue_id: str, direction: str) -> list[dict]:
    data = run_bd_json(["dep", "list", issue_id, f"--direction={direction}", "--json"])
    return data if isinstance(data, list) else []


def fetch_comments(issue_id: str) -> list[dict]:
    data = run_bd_json(["comments", issue_id, "--json"])
    return data if isinstance(data, list) else []


def make_console(out) -> Console:
    width = shutil.get_terminal_size((100, 24)).columns
    return Console(file=out, force_terminal=True, width=width,
                   soft_wrap=False, theme=QUIET_THEME)


def section_header(console: Console, title: str) -> None:
    console.print()
    console.print(Text(f"=== {title} ===", style="bold"))


def render_header(console: Console, issue: dict) -> None:
    iid = issue.get("id", "?")
    title = issue.get("title") or "(no title)"
    status = issue.get("status") or ""
    glyph = STATUS_GLYPH.get(status, "·")
    style = STATUS_STYLE.get(status, "white")
    prio = format_priority(issue.get("priority"))
    itype = issue.get("issue_type") or ""

    head = Text()
    head.append(f"{glyph} ", style=style)
    head.append(iid, style="bold")
    head.append("  ")
    head.append(title, style="bold white")
    console.print(head)

    meta = Text()
    meta.append("status: ")
    meta.append(status or "?", style=style)
    meta.append(f"  ·  priority: {prio}  ·  type: {itype}", style="dim")
    console.print(meta)

    owner = issue.get("owner") or ""
    assignee = issue.get("assignee") or ""
    bits = []
    if owner:
        bits.append(f"owner: {owner}")
    if assignee:
        bits.append(f"assignee: {assignee}")
    if bits:
        console.print(Text("  ·  ".join(bits), style="dim"))

    date_bits = []
    for label, key in (("created", "created_at"),
                       ("started", "started_at"),
                       ("updated", "updated_at"),
                       ("closed", "closed_at"),
                       ("deferred", "defer_until")):
        ts = issue.get(key)
        if ts:
            date_bits.append(f"{label}: {format_ts(ts)}")
    if date_bits:
        console.print(Text("  ·  ".join(date_bits), style="dim"))

    labels = issue.get("labels") or []
    if labels:
        console.print(Text(f"labels: {', '.join(labels)}", style="dim"))

    ref_bits = []
    if issue.get("external_ref"):
        ref_bits.append(f"external: {issue['external_ref']}")
    if issue.get("spec_id"):
        ref_bits.append(f"spec: {issue['spec_id']}")
    if ref_bits:
        console.print(Text("  ·  ".join(ref_bits), style="dim"))

    close_reason = issue.get("close_reason")
    if close_reason:
        console.print(Text(f"close reason: {close_reason}", style="dim"))

    created_by = issue.get("created_by")
    if created_by and created_by not in (owner, assignee):
        console.print(Text(f"created by: {created_by}", style="dim"))


def render_section(console: Console, title: str, body: str) -> None:
    if not body or not body.strip():
        return
    section_header(console, title)
    console.print(Markdown(with_hard_breaks(body)))


def render_pairs(console: Console, title: str, pairs: list[tuple[str, str]]) -> None:
    """A section of dim 'key: value' lines (metadata, leftover fields).

    Laid out as a borderless grid rather than hand-padded text so that a long
    value (metadata's 'defer_reason' is routinely a paragraph) wraps under its
    own column instead of running back to the left margin."""
    if not pairs:
        return
    section_header(console, title)
    grid = Table.grid(padding=(0, 1))
    grid.add_column(style="dim", no_wrap=True)
    grid.add_column(overflow="fold")
    for key, value in pairs:
        grid.add_row(f"  {key}:", value)
    console.print(grid)


def render_deps(console: Console, deps: list[dict], dependents: list[dict],
                parent_id: str = "") -> None:
    if not deps and not dependents and not parent_id:
        return
    section_header(console, "Dependencies")

    def render_list(label: str, items: list[dict]) -> None:
        if not items:
            return
        console.print(Text(label, style="bold"))
        for d in items:
            status = d.get("status") or ""
            glyph = STATUS_GLYPH.get(status, "·")
            style = STATUS_STYLE.get(status, "white")
            iid = d.get("id", "?")
            title = d.get("title") or "(no title)"
            prio = format_priority(d.get("priority"))
            itype = d.get("issue_type") or ""
            extra = " ".join(s for s in (prio, status, itype) if s)
            line = Text("  ")
            line.append(f"{glyph} ", style=style)
            line.append(iid, style="bold")
            line.append("  ")
            line.append(title)
            if extra:
                line.append(f"  ({extra})", style="dim")
            console.print(line)

    # The bead's own 'parent' field is the source of truth; if no parent-child
    # edge came back from `bd dep list`, still show the bare id (in the same
    # leading position the edge-derived 'Parent:' group would occupy).
    if parent_id and not has_parent_edge(deps):
        console.print(Text("Parent:", style="bold"))
        line = Text("  · ")
        line.append(parent_id, style="bold")
        console.print(line)

    for direction, dep_type, items in group_deps(deps, dependents):
        render_list(dep_heading(direction, dep_type), items)


def render_comments(console: Console, comments: list[dict]) -> None:
    if not comments:
        return
    section_header(console, "Comments")
    for i, c in enumerate(comments):
        if i:
            console.print()
        author = c.get("author") or "(unknown)"
        ts = format_ts(c.get("created_at") or "")
        head = Text()
        head.append(author, style="bold")
        if ts:
            head.append(f"  ·  {ts}", style="dim")
        console.print(head)
        text = c.get("text") or ""
        if text.strip():
            console.print(Markdown(with_hard_breaks(text)))


def render_with_rich(out, issue: dict, deps: list[dict],
                     dependents: list[dict], comments: list[dict]) -> None:
    console = make_console(out)
    render_header(console, issue)
    render_section(console, "Description", issue.get("description") or "")
    render_section(console, "Design", issue.get("design") or "")
    render_section(console, "Notes", issue.get("notes") or "")
    render_section(console, "Acceptance Criteria", issue.get("acceptance_criteria") or "")
    render_pairs(console, "Metadata",
                 flatten_pairs(issue.get("metadata") or {}))
    render_deps(console, deps, dependents, issue.get("parent") or "")
    render_comments(console, comments)
    render_pairs(console, "Other Fields", extra_fields(issue))


def render_plain(out, issue: dict, deps: list[dict],
                 dependents: list[dict], comments: list[dict]) -> None:
    def w(s: str = "") -> None:
        print(s, file=out)

    iid = issue.get("id", "?")
    title = issue.get("title") or "(no title)"
    w(f"{iid}  {title}")

    status = issue.get("status") or "?"
    prio = format_priority(issue.get("priority"))
    itype = issue.get("issue_type") or ""
    w(f"status: {status}  priority: {prio}  type: {itype}")

    owner = issue.get("owner") or ""
    assignee = issue.get("assignee") or ""
    bits = []
    if owner:
        bits.append(f"owner: {owner}")
    if assignee:
        bits.append(f"assignee: {assignee}")
    if bits:
        w("  ".join(bits))

    date_bits = []
    for label, key in (("created", "created_at"),
                       ("started", "started_at"),
                       ("updated", "updated_at"),
                       ("closed", "closed_at"),
                       ("deferred", "defer_until")):
        ts = issue.get(key)
        if ts:
            date_bits.append(f"{label}: {format_ts(ts)}")
    if date_bits:
        w("  ".join(date_bits))

    labels = issue.get("labels") or []
    if labels:
        w(f"labels: {', '.join(labels)}")

    ref_bits = []
    if issue.get("external_ref"):
        ref_bits.append(f"external: {issue['external_ref']}")
    if issue.get("spec_id"):
        ref_bits.append(f"spec: {issue['spec_id']}")
    if ref_bits:
        w("  ".join(ref_bits))

    if issue.get("close_reason"):
        w(f"close reason: {issue['close_reason']}")

    created_by = issue.get("created_by")
    if created_by and created_by not in (owner, assignee):
        w(f"created by: {created_by}")

    def section(name: str, body: str) -> None:
        if body and body.strip():
            w()
            w(f"== {name} ==")
            w(body)

    def pair_section(name: str, pairs: list[tuple[str, str]]) -> None:
        if not pairs:
            return
        w()
        w(f"== {name} ==")
        label_width = max(len(k) for k, _ in pairs) + 4  # '  ' + ':' + ' '
        term_width = shutil.get_terminal_size((100, 24)).columns
        wrap_width = max(term_width - label_width, 20)
        for key, value in pairs:
            label = f"  {key}:".ljust(label_width)
            # Continuation lines hang under the value column, not column 0.
            chunks = textwrap.wrap(value, wrap_width) or [""]
            w(f"{label}{chunks[0]}")
            for chunk in chunks[1:]:
                w(f"{' ' * label_width}{chunk}")

    section("DESCRIPTION", issue.get("description") or "")
    section("DESIGN", issue.get("design") or "")
    section("NOTES", issue.get("notes") or "")
    section("ACCEPTANCE CRITERIA", issue.get("acceptance_criteria") or "")
    pair_section("METADATA", flatten_pairs(issue.get("metadata") or {}))

    parent_id = issue.get("parent") or ""
    if deps or dependents or parent_id:
        w()
        w("== DEPENDENCIES ==")
        if parent_id and not has_parent_edge(deps):
            w("Parent:")
            w(f"  {parent_id}")
        for direction, dep_type, items in group_deps(deps, dependents):
            w(dep_heading(direction, dep_type))
            for d in items:
                w(f"  {d.get('id', '?')}  {d.get('status', '')}  {d.get('title', '')}")

    if comments:
        w()
        w("== COMMENTS ==")
        for i, c in enumerate(comments):
            if i:
                w()
            author = c.get("author") or "(unknown)"
            ts = format_ts(c.get("created_at") or "")
            w(f"-- {author}  {ts} --")
            w(c.get("text") or "")

    pair_section("OTHER FIELDS", extra_fields(issue))


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Pretty-print a beads issue with rendered Markdown.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Renders a single bead's full content (description, design, notes,\n"
            "acceptance criteria, metadata, dependencies, comments) with proper\n"
            "Markdown formatting via the 'rich' library. Dependencies are grouped\n"
            "by relationship (parent, children, depends-on, blocks, ...), and any\n"
            "field this script doesn't render explicitly is listed under 'Other\n"
            "Fields' rather than dropped. Output is paged through $PAGER (or\n"
            "'less -FRX') when stdout is a tty.\n"
            "\n"
            "Examples:\n"
            "  bd-view beads-utils-s4s\n"
        ),
    )
    parser.add_argument("issue_id", help="Issue id to view (e.g. beads-utils-s4s)")
    parser.add_argument(
        "--no-pager", action="store_true",
        help="Write directly to stdout; skip the pager ($PAGER or less -FRX).",
    )
    add_version_arg(parser)
    args = parser.parse_args()

    issue = fetch_issue(args.issue_id)
    deps = fetch_deps(args.issue_id, "down")
    dependents = fetch_deps(args.issue_id, "up")
    comments = fetch_comments(args.issue_id)

    if not HAVE_RICH:
        warn("'rich' not installed; falling back to plain text "
             "(install with: pip install rich)")

    with paged_output(no_pager=args.no_pager) as out:
        if HAVE_RICH:
            render_with_rich(out, issue, deps, dependents, comments)
        else:
            render_plain(out, issue, deps, dependents, comments)

    return 0


if __name__ == "__main__":
    sys.exit(main())
