#!/usr/bin/env python3
"""Show recent beads and memory events in a git-log-style view."""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

from bdutils import (
    add_color_arg,
    add_version_arg,
    dolt_sql_json,
    error,
    format_priority,
    format_ts,
    have_dolt,
    locate_dolt_db,
    paged_output,
    paint,
    read_metadata,
    resolve_project_path,
    want_color,
    warn,
)

# --- The event grid -------------------------------------------------------
#
# Two orthogonal axes rather than one flat list of event kinds. A bead and a
# memory have parallel lifecycles, so the same three verbs describe both:
#
#               create        change      end
#   beads       created       started     closed
#   memories    remembered    revised     forgotten
#
# --only picks the column, --about picks the row. The pairing is what lets the
# palette below stay at three hues: color follows the *verb*, so both creates
# are blue and both ends are red, and the entity rides on the glyph (and is
# spelled out in the meta cell) instead of claiming a fourth hue.
ENTITIES = ("beads", "memories")
VERBS = ("create", "change", "end")
# bd-log shipped with --only=create,start,close, and those spellings stay valid
# forever: they are the beads row's own verbs, and they are all over this
# repo's epilogs, CLAUDE.md and both completion files.
VERB_ALIASES = {"start": "change", "close": "end"}
ENTITY_ALIASES = {"bead": "beads", "memory": "memories"}

BEAD_KINDS = ("create", "start", "close")
MEMORY_KINDS = ("remember", "revise", "forget")
MEMORY_KIND_SET = frozenset(MEMORY_KINDS)
EVENT_KINDS = BEAD_KINDS + MEMORY_KINDS
KIND_BY_ENTITY_VERB = {
    "beads": dict(zip(VERBS, BEAD_KINDS)),
    "memories": dict(zip(VERBS, MEMORY_KINDS)),
}

# Beads carry their own timestamps; memory events are reconstructed from Dolt
# commit history instead, so only the beads row appears here.
EVENT_TS_FIELD = {
    "create": "created_at",
    "start": "started_at",
    "close": "closed_at",
}
# Memory glyphs are ASCII on purpose. '▶' is East-Asian-ambiguous and already
# mis-columns in some terminals (beads-utils-fh0); adding three more wide
# glyphs would widen that bug rather than leave it where it is.
EVENT_GLYPH = {
    "create": "+", "start": "▶", "close": "✓",
    "remember": "*", "revise": "~", "forget": "x",
}
EVENT_ORDER = {
    "create": 0, "start": 1, "close": 2,
    "remember": 0, "revise": 1, "forget": 2,
}
# What each glyph means, for the trailing legend. Past tense: the legend
# describes what a row *records*, not what the flag asks for -- --only takes
# the verb ('create'), a row reports the event ('created').
KIND_LABEL = {
    "create": "created", "start": "started", "close": "closed",
    "remember": "remembered", "revise": "revised", "forget": "forgotten",
}
# Traffic-light semantics, one hue per *verb*: red goes on the event where work
# stops (a bead closed, a memory forgotten), green on the one where it moves (a
# bead started -- a play button is green -- or a memory revised), and blue on
# create, which is neither.
#
# The obvious alternative maps the *sequence* instead (create green -> change
# yellow -> end red). It's rejected on legibility: in Solarized Light -- and
# low-contrast light themes generally -- ANSI green and yellow are both olive
# (#859900 / #b58900), so it would put two near-identical colors on adjacent
# lifecycle events. Blue/green/red are the three most separated hues available.
# Plain hues, deliberately no 'bold'. Bold looks like the free way to raise
# contrast, but terminals with "draw bold text in bright colors" enabled remap
# it to the bright slots (90-97) -- which Solarized repurposes as greys. Tried
# and rejected empirically: bold green rendered as grey base01, i.e. the start
# events lost their color entirely. See the bright-slot note in bdutils.paint.
EVENT_COLOR = {
    "create": "blue", "start": "green", "close": "red",
    "remember": "blue", "revise": "green", "forget": "red",
}

# 'bd remember' stores a memory as a row in the Dolt `config` table, keyed
# 'kv.memory.<key>' -- key and value, no timestamps anywhere, and bd's own
# `events` audit table records only issue lifecycle rows. So the *only* source
# for when a memory appeared or changed is Dolt's commit history.
MEMORY_PREFIX = "kv.memory."
MEMORY_QUERY = (
    "select to_key, from_key, to_commit, to_commit_date, diff_type, "
    "to_value, from_value from dolt_diff_config "
    f"where coalesce(to_key, from_key) like '{MEMORY_PREFIX}%';"
)
MEMORY_DIFF_KIND = {"added": "remember", "modified": "revise", "removed": "forget"}
# Memory keys run to ~50 characters against ~17 for a bead id, so in --oneline
# an uncapped key sets the column width for every bead row too -- which is
# beads-utils-u20's failure mode, and visibly so: on this repo's own log it
# padded 15-character ids out to 32. 24 was picked off the rendered output as
# the point where keys stay recognizable ('checkpoint-commit-bef...') while the
# dead space on bead rows drops to a few characters. The block form passes no
# cap at all, having no column to protect.
MEMORY_KEY_MAX = 24
MEMORY_VALUE_MAX = 100
ELLIPSIS = "..."  # ASCII, for the same width reason as the glyphs above

STAMP_WIDTH = len("YYYY-MM-DD HH:MM")
UNCOMMITTED = "(uncommitted)"
# An event with no timestamp is a memory change sitting in Dolt's working set.
# It is a *descendant* of every commit, so it leads -- but that is a DAG fact,
# not a wall-clock one, and the two must not be confused. In a repo where bd
# commits the issue tables but never `config`, the working set is long-lived:
# on nutshell-mvp its HEAD is minutes old while the newest *committed* memory
# change is three weeks back, so those pending edits fall somewhere in a
# three-week window that nothing can narrow. dolt offers no other clock --
# to_commit_date is NULL, dolt_status has no time column, and from_commit_date
# dates HEAD rather than the edit.
#
# So they are shown as a labelled group ahead of the dated log rather than
# merged into it, and '' sorts *lowest* -- the bottom of a reversed sort --
# which is why the sort key substitutes a sentinel that outranks every real
# timestamp.
NO_TIMESTAMP_SORTS_AS = "\uffff"
PENDING_HEADER = "uncommitted -- no date until committed"
LEGEND_INDENT = "  "


def scope_args(status: str | None, open_only: bool) -> list[str]:
    """The 'bd list' flags for the requested scope.

    Three scopes, mutually exclusive by construction:
      --status=LIST -> delegate the filter (and its vocabulary) to bd
      --open        -> plain 'bd list', whose default already means "not closed"
      neither       -> --all, the backward-compatible everything-incl-closed view
    """
    if status:
        return [f"--status={status}"]
    if open_only:
        return []
    return ["--all"]


def run_bd_list(
    project_path: Path, scope: list[str], ids: list[str] | None,
) -> list[dict]:
    cmd = ["bd", "list", *scope, "--limit", "0", "--json"]
    # The id filter is orthogonal to scope and composes with all three. Like
    # --status, it delegates to bd rather than matching locally, so bd owns the
    # id vocabulary (full ids only -- 'bd list --id y13' matches nothing).
    # --children is the one case that cannot delegate; see select_subtrees.
    if ids:
        cmd.append(f"--id={','.join(ids)}")
    try:
        result = subprocess.run(
            cmd, cwd=project_path, capture_output=True, text=True, check=True,
        )
    except FileNotFoundError:
        error("'bd' not found on PATH")
    except subprocess.CalledProcessError as exc:
        if exc.stderr:
            sys.stderr.write(exc.stderr)
        error(f"bd list failed (exit {exc.returncode})")
    try:
        return json.loads(result.stdout) if result.stdout.strip() else []
    except json.JSONDecodeError as exc:
        error(f"could not parse bd list JSON output: {exc}")


def select_subtrees(
    issues: list[dict], topology: list[dict], roots: list[str],
) -> tuple[list[dict], dict[str, set[str]]]:
    """Narrow `issues` to the subtree under each of `roots` (root included).

    Returns the surviving issues plus a per-root map of the in-scope ids it
    claimed, so the caller can tell which roots came back empty.

    bd cannot do this for us: 'bd list --id' does not expand children, and
    --parent walks a single level per call. So membership is the transitive
    closure over the 'parent' field -- walked over `topology` (the whole
    'bd list --all' set) rather than over `issues`, because a scope filter that
    hides an intermediate bead would otherwise sever the chain to everything
    below it. Only the final membership test is scoped.

    Nothing here matches on id *text*. Dotted ids like 'proj-a1b.4' look like
    they encode parentage, but 'bd update --parent' reparents without
    renumbering, so a moved bead keeps an id that names its former parent.
    """
    children: dict[str, list[str]] = {}
    for issue in topology:
        parent = issue.get("parent")
        iid = issue_id(issue)
        if parent and iid:
            children.setdefault(parent, []).append(iid)

    in_scope = {issue_id(i) for i in issues}
    members: dict[str, set[str]] = {}
    for root in roots:
        found: set[str] = set()
        # `seen` bounds the walk, so a parent cycle (which bd should never emit,
        # but nothing here guarantees) terminates instead of spinning.
        stack = [root]
        seen = {root}
        while stack:
            current = stack.pop()
            if current in in_scope:
                found.add(current)
            for child in children.get(current, []):
                if child not in seen:
                    seen.add(child)
                    stack.append(child)
        members[root] = found

    keep: set[str] = set()
    for found in members.values():
        keep |= found
    return [i for i in issues if issue_id(i) in keep], members


def issue_id(issue: dict) -> str:
    """Id of an issue, normalized to '' when absent so it can't match a root."""
    return issue.get("id") or ""


def display_id(issue: dict) -> str:
    """Id for *display*, falling back to '?' when missing, empty, or null.

    Deliberately not issue_id(), which normalizes the same field to '' --
    that one feeds id matching, where a falsy id must not collide with a
    requested root. Here '' would render as a hole in the id column (and
    None would crash the join), so both become '?'.
    """
    return issue.get("id") or "?"


def collapse(s: str) -> str:
    return " ".join(s.split())


def truncate(text: str, limit: int) -> str:
    """`text` cut to `limit` characters, with an ASCII ellipsis when it was."""
    if len(text) <= limit:
        return text
    return text[:limit - len(ELLIPSIS)] + ELLIPSIS


def is_memory(kind: str) -> bool:
    return kind in MEMORY_KIND_SET


def synthesize_events(issues: list[dict], kinds: set[str]) -> list[tuple[str, str, dict]]:
    """One event per non-empty lifecycle timestamp on each issue.

    Memory kinds are silently ignored rather than raising: `kinds` is the whole
    grid selection, and it is the caller's convenience -- not a contract -- that
    the memory half is fetched elsewhere.
    """
    events: list[tuple[str, str, dict]] = []
    for issue in issues:
        for kind in kinds:
            field = EVENT_TS_FIELD.get(kind)
            ts = issue.get(field) or "" if field else ""
            if ts:
                events.append((ts, kind, issue))
    return events


def normalize_dolt_ts(raw: str | None) -> str:
    """Dolt's '2026-08-02 19:55:33.460000' (UTC) as bd's '2026-08-02T19:55:33Z'.

    The two must share one spelling: the merged timeline sorts events as plain
    strings, and --since compares a bare 'YYYY-MM-DD' as a prefix of them. A
    missing date -- which is what an uncommitted working-set change has, since
    Dolt's JSON output omits NULL columns entirely -- becomes '', the marker the
    rest of the script reads as "no timestamp".
    """
    text = (raw or "").strip()
    if len(text) < 19:
        return ""
    return text[:19].replace(" ", "T") + "Z"


def memory_events(project_path: Path, kinds: set[str]) -> list[tuple[str, str, dict]] | None:
    """Memory add/change/remove events, or None if the history can't be read.

    None and [] are different answers on purpose: [] means the history was read
    and holds nothing, None means there was nothing to read it from (no Dolt
    CLI, a JSONL-only repo, an unreadable database). Only the caller knows
    whether the user asked for memories explicitly, and so whether to complain.
    """
    beads_dir = project_path / ".beads"
    # read_metadata() exits the process when metadata.json is missing, which is
    # the right behavior for the dolt scripts and the wrong one here -- bd-log
    # must still print bead events for a repo with no Dolt database at all.
    if not (beads_dir / "metadata.json").is_file() or not have_dolt():
        return None
    db_name, _ = read_metadata(beads_dir)
    dolt_db_dir = locate_dolt_db(beads_dir, db_name)
    if dolt_db_dir is None:
        return None
    rows = dolt_sql_json(dolt_db_dir, MEMORY_QUERY)
    if rows is None:
        return None

    events: list[tuple[str, str, dict]] = []
    seen: set[tuple[str, str]] = set()
    for row in rows:
        kind = MEMORY_DIFF_KIND.get(row.get("diff_type", ""))
        if kind is None or kind not in kinds:
            continue
        full_key = row.get("to_key") or row.get("from_key") or ""
        # A merge commit can re-report one logical change, so a (key, commit)
        # pair is taken once. Working-set rows all share the same sentinel
        # commit, which is why the key is part of the identity too.
        identity = (full_key, row.get("to_commit", ""))
        if identity in seen:
            continue
        seen.add(identity)
        # A removal's value only survives on the `from` side.
        value = row.get("from_value") if kind == "forget" else row.get("to_value")
        events.append((
            normalize_dolt_ts(row.get("to_commit_date")),
            kind,
            {"key": full_key[len(MEMORY_PREFIX):], "value": value or ""},
        ))
    return events


def filter_since(events: list[tuple[str, str, dict]], since: str) -> list[tuple[str, str, dict]]:
    """Drop events older than `since`, comparing the timestamps as strings.

    That works because RFC3339 is fixed-width and zero-padded, so lexical
    order is chronological order -- and a bare 'YYYY-MM-DD' bound is a prefix
    of every timestamp on that date, so it sorts before all of them and the
    whole day is included.

    Undated events (uncommitted memory changes) always survive: they are newer
    than every commit, so no `since` bound can exclude them. Pushing the bound
    into SQL instead would have dropped them silently -- a NULL date fails
    every comparison.
    """
    return [e for e in events if not e[0] or e[0] >= since]


def split_pending(events: list[tuple[str, str, dict]]) -> tuple[list, list]:
    """(undated, dated), each keeping the order it arrived in.

    The undated ones are uncommitted memory changes. They are split out
    because --limit should not spend its budget on them: -n asks how far back
    through the *history* to go, and a pending change isn't in the history
    yet -- 'git log -n 4' doesn't count your working tree against the four
    either. Without this, a repo carrying half a dozen uncommitted memories
    answers 'bd-log --open -n 4' with four of those and no beads at all.
    """
    return [e for e in events if not e[0]], [e for e in events if e[0]]


def sort_events(events: list[tuple[str, str, dict]]) -> list[tuple[str, str, dict]]:
    """Newest first, with same-timestamp events in lifecycle order.

    The kind rank is negated because the whole sort is reversed: that keeps
    create -> start -> close reading top-down within a single timestamp, while
    the timestamps themselves run newest-first. The id (or memory key) is the
    final tiebreak, so two events stamped the same second don't swap places
    between runs.
    """
    return sorted(
        events,
        key=lambda e: (
            e[0] or NO_TIMESTAMP_SORTS_AS,
            -EVENT_ORDER[e[1]],
            e[2].get("id") or e[2].get("key") or "",
        ),
        reverse=True,
    )


def event_actor(kind: str, payload: dict) -> str:
    """Who did it -- for beads only.

    A memory event has no recoverable actor: Dolt records the committer as
    'root', and the real name appears only inside the commit *message* text,
    which is too fragile to parse.
    """
    if is_memory(kind):
        return ""
    if kind == "create":
        return payload.get("created_by") or payload.get("owner") or ""
    return payload.get("assignee") or payload.get("owner") or ""


def event_id(kind: str, payload: dict, cap: int | None = None) -> str:
    """The id cell: a bead id, or a memory key with its 'kv.memory.' prefix gone.

    `cap` truncates a long key, and only --oneline passes one. The block form
    has no column to protect -- it is the render_oneline caller that has to
    care, because there the widest cell pads every other row, and memory keys
    (~50 chars) would otherwise set the width for bead ids (~17) that are
    nowhere near it. Bead ids are never capped here; that is beads-utils-u20's
    territory, and shortening an id would break the copy-paste this column
    exists for.
    """
    if is_memory(kind):
        key = payload.get("key") or "?"
        return truncate(key, cap) if cap else key
    return display_id(payload)


def event_meta(kind: str, payload: dict) -> str:
    """The 'P3 task' priority+type cell, or 'memory' for a memory event.

    Never empty: format_priority() falls back to 'P?' rather than ''. That is
    what lets render_oneline pad the column unconditionally instead of
    carrying an unreachable zero-width branch.
    """
    if is_memory(kind):
        return "memory"
    prio = format_priority(payload.get("priority"))
    itype = payload.get("issue_type", "") or ""
    return f"{prio} {itype}".strip()


def event_title(kind: str, payload: dict) -> str:
    """The body line: a bead title, or a memory's value collapsed to one line.

    Memory values run to well over a thousand characters, so unlike a title
    this one is truncated -- shedding the bulk is the whole point of showing it
    at the same size as a title.
    """
    if is_memory(kind):
        return truncate(collapse(payload.get("value") or ""), MEMORY_VALUE_MAX) or "(empty)"
    # Fallback applied *after* collapsing, not to the raw value: a title of
    # '   ' is truthy, so testing it first lets whitespace through, and the
    # body then renders as a painted empty line (with the padding trapped
    # inside the color span, ahead of the reset).
    return collapse(payload.get("title") or "") or "(no title)"


def event_stamp(ts: str) -> str:
    """The timestamp cell, padded so the columns behind it line up.

    Padding is a no-op for a real timestamp (format_ts always returns exactly
    STAMP_WIDTH characters); it exists for the '(uncommitted)' marker, which
    is shorter.
    """
    return f"{format_ts(ts) if ts else UNCOMMITTED:<{STAMP_WIDTH}}"


def render(ts: str, kind: str, payload: dict, color: bool = False) -> list[str]:
    head_bits = [
        f"{EVENT_GLYPH[kind]} {event_stamp(ts)}",
        event_id(kind, payload),
        event_meta(kind, payload),
    ]
    actor = event_actor(kind, payload)
    if actor:
        head_bits.append(actor)
    lines = ["  ".join(head_bits), f"  {event_title(kind, payload)}"]
    if kind == "close":
        reason = collapse(payload.get("close_reason") or "")
        if reason:
            lines.append(f"  {reason}")
    # The whole entry is tinted, not just the leading stamp. A stamp is ~18
    # chars of an ~80-char entry -- too little area to judge a hue against, so
    # the kinds read alike no matter which colors are picked. Painting each
    # line separately (rather than one span across the newlines) keeps every
    # line independently reset, which is what pagers and line-oriented tools
    # downstream expect.
    return [paint(line, EVENT_COLOR[kind], color) for line in lines]


def oneline_widths(events: list[tuple[str, str, dict]]) -> tuple[int, int]:
    """Column widths for --oneline, sized to the events actually rendered.

    Called after --limit trims, so a long-tail id in a truncated run doesn't
    pad every visible row (same rule as claude-session-list --oneline).
    """
    id_w = max((len(event_id(e[1], e[2], MEMORY_KEY_MAX)) for e in events), default=0)
    meta_w = max((len(event_meta(e[1], e[2])) for e in events), default=0)
    return id_w, meta_w


def render_oneline(ts: str, kind: str, payload: dict, id_w: int, meta_w: int,
                   color: bool = False) -> str:
    """One row per event: 'glyph ts  id  P3 task  title'.

    Drops the actor (near-constant in a single-owner project) and the close
    reason (which is a full paragraph in practice -- shedding it is the point
    of the flag). Deliberately no header row, unlike claude-session-list
    --oneline: this is a git-log-style view whose columns are self-describing,
    every row is tinted by event kind so a header would sit uncolored atop a
    colored table, and the output gets grepped. Titles are not truncated to
    terminal width -- git doesn't, and it keeps pipes honest.
    """
    bits = [
        f"{EVENT_GLYPH[kind]} {event_stamp(ts)}",
        f"{event_id(kind, payload, MEMORY_KEY_MAX):<{id_w}}",
        f"{event_meta(kind, payload):<{meta_w}}",
        event_title(kind, payload),
    ]
    return paint("  ".join(bits), EVENT_COLOR[kind], color)


def want_legend(mode: str = "auto") -> bool:
    """Whether to print the trailing key, for --legend=auto|always|never.

    Same tri-state shape as --color, resolved separately: bdutils.want_color
    also consults NO_COLOR and TERM, which govern *color* and have nothing to
    say about whether a symbol key is wanted. 'auto' is simply "a human is
    reading this", so pipes and grep stay clean by default.

    Callers must resolve this against sys.stdout *before* entering
    paged_output(), which yields the pager's stdin pipe -- never a tty, and so
    always the wrong answer in exactly the case the key is for.
    """
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def render_legend(color: bool = False) -> list[str]:
    """The trailing symbol key, laid out as the grid the flags describe.

    Printing it as a grid rather than a flat list is the point: it is the same
    shape as --only x --about, so it doubles as a reminder of what those two
    select. Each cell is tinted like the rows it explains, which makes it a
    color key as well -- the alternative, naming the hues in words, tells you
    what they are called rather than what they look like in your theme.

    Widths come from len(), so the two wide glyphs ('▶', '✓') can push their
    column a character narrow in terminals that render them double-width. Same
    bug as beads-utils-fh0, same fix when that lands.
    """
    kind_at = {
        (entity, verb): KIND_BY_ENTITY_VERB[entity][verb]
        for entity in ENTITIES for verb in VERBS
    }
    cell = {at: f"{EVENT_GLYPH[k]} {KIND_LABEL[k]}" for at, k in kind_at.items()}
    col_w = {v: max(len(cell[(e, v)]) for e in ENTITIES) for v in VERBS}
    label_w = max([len("key")] + [len(LEGEND_INDENT + e) for e in ENTITIES])

    def row(label: str, cells: list[str]) -> str:
        return f"{label:<{label_w}}  " + "  ".join(cells)

    lines = [row("key", [f"{v:<{col_w[v]}}" for v in VERBS]).rstrip()]
    for entity in ENTITIES:
        painted = []
        for i, verb in enumerate(VERBS):
            # The last column goes unpadded: padding inside a colored span
            # would leave blanks between the text and its reset code.
            last = i == len(VERBS) - 1
            body = cell[(entity, verb)]
            painted.append(paint(
                body if last else f"{body:<{col_w[verb]}}",
                EVENT_COLOR[kind_at[(entity, verb)]],
                color,
            ))
        lines.append(row(LEGEND_INDENT + entity, painted))
    return lines


def parse_only(value: str) -> set[str]:
    """The verb axis: 'create,change,end', plus the pre-grid names for two of them."""
    parts = [p.strip() for p in value.split(",") if p.strip()]
    if not parts:
        error("--only must list at least one event verb")
    verbs = {VERB_ALIASES.get(p, p) for p in parts}
    unknown = [p for p in parts if VERB_ALIASES.get(p, p) not in VERBS]
    if unknown:
        aliases = ", ".join(f"{a}={v}" for a, v in VERB_ALIASES.items())
        error(
            f"unknown event verb(s): {', '.join(unknown)} "
            f"(known: {', '.join(VERBS)}; also accepted: {aliases})"
        )
    return verbs


def parse_about(value: str) -> set[str]:
    """The entity axis: 'beads,memories', singular spellings accepted."""
    parts = [p.strip() for p in value.split(",") if p.strip()]
    if not parts:
        error("--about must list at least one entity")
    entities = {ENTITY_ALIASES.get(p, p) for p in parts}
    unknown = [p for p in parts if ENTITY_ALIASES.get(p, p) not in ENTITIES]
    if unknown:
        error(
            f"unknown entity/entities: {', '.join(unknown)} "
            f"(known: {', '.join(ENTITIES)})"
        )
    return entities


def select_kinds(entities: set[str], verbs: set[str]) -> set[str]:
    """The cells of the grid that both axes select."""
    return {
        KIND_BY_ENTITY_VERB[entity][verb]
        for entity in entities
        for verb in verbs
    }


def parse_status(value: str) -> str:
    """Reject an empty --status, the way parse_ids rejects an empty --id.

    Same hazard, same reason. `--status="$UNSET_VAR"` is a passed-but-empty
    flag, and reading it as absent is doubly wrong here: scope_args falls
    through to --all, *and* --status drops out of the filters that imply
    --about=beads -- so a typo that looks like a narrowing quietly returns
    every bead plus the entire memory log. Erroring by name means every
    downstream truthiness test on args.status is equivalent to 'is not None'.
    """
    if not value.strip():
        error("--status must name at least one status")
    return value


def parse_ids(value: str) -> list[str]:
    parts = [p.strip() for p in value.split(",") if p.strip()]
    if not parts:
        error("--id must list at least one bead id")
    return list(dict.fromkeys(parts))  # dedupe, preserve the order given


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Show recent beads and memory events in a git-log-style view.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Events form a grid: --only picks the verb, --about picks what the\n"
            "verb happened to. Both default to everything.\n"
            "\n"
            "              create        change        end\n"
            "  beads       + created     ▶ started     ✓ closed\n"
            "  memories    * remembered  ~ revised     x forgotten\n"
            "\n"
            "On a tty the whole entry is tinted by verb, traffic-light style:\n"
            "blue on create, green on change (where work moves -- a play button\n"
            "is green), red on end (where it stops). 'start' and 'close' are\n"
            "still accepted as --only values, for the change and end columns.\n"
            "A tinted copy of that grid prints as a key below the log, so the\n"
            "colors are shown rather than named; --legend controls it.\n"
            "\n"
            "Memory history comes from Dolt's commit log, since 'bd remember'\n"
            "records no timestamps of its own. That means it needs the 'dolt'\n"
            "CLI and a Dolt-backed repo. A memory written but not yet committed\n"
            "has no date at all, so those changes are listed as a labelled\n"
            "group ahead of the dated log, and -n does not count them against\n"
            "its budget -- they are not in the history yet.\n"
            "\n"
            "The bead-scoping filters are orthogonal to both axes:\n"
            "  --status=LIST     which beads to include, by *current* status\n"
            "                    (passed through to 'bd list --status'; comma-\n"
            "                    separated). --open is shorthand for \"not closed\".\n"
            "  --id=LIST         which beads to include, by id (comma-separated\n"
            "                    full ids, as 'bd list --id' expects). --children\n"
            "                    widens each id to its whole subtree.\n"
            "--id and --status imply --about=beads -- a memory is never one\n"
            "of the ids you listed, and bd (not bd-log) owns the status\n"
            "vocabulary, so there is no telling whether a status list means\n"
            "live or done. --open does not: it means 'still in force', which\n"
            "covers memories too. Pass --about explicitly to override either.\n"
            "\n"
            "Examples:\n"
            "  bd-log                         Everything, beads and memories\n"
            "  bd-log -n 10                   Last 10 events\n"
            "  bd-log --oneline               One row per event\n"
            "  bd-log --about=memories        Memory history on its own\n"
            "  bd-log --about=memories -n 5   The five most recent memory events\n"
            "  bd-log --about=beads           Beads only (the pre-grid behavior)\n"
            "  bd-log --only=create           Beads created and memories added\n"
            "  bd-log --open                  Events for beads that are still open\n"
            "  bd-log --status=in_progress    Only currently in-progress beads\n"
            "  bd-log --only=start --open     What's actively being worked\n"
            "  bd-log --only=close            Closures only\n"
            "  bd-log --only=create,close     Narrow to two verbs\n"
            "  bd-log --id bd-1               One bead's whole history\n"
            "  bd-log --id bd-1,bd-5          Several beads\n"
            "  bd-log --id bd-1 --children    That bead and everything under it\n"
            "  bd-log --since 2026-04-01      Events on/after date\n"
            "  bd-log /path/to/project        Check a different project\n"
            "\n"
            "Output is paged through $PAGER (or 'less -FRX') when stdout is a\n"
            "tty; -F makes less exit immediately when content fits one screen,\n"
            "so short output looks direct. Use --no-pager to disable.\n"
            "\n"
            "Color follows --color (default 'auto': a tty, NO_COLOR unset, TERM\n"
            "not 'dumb'). 'less -FRX' passes the escapes through via -R; a\n"
            "$PAGER without -R will show them literally, so use --color=never\n"
            "there. --color=always keeps color through a pipe (e.g. into grep).\n"
        ),
    )
    parser.add_argument(
        "project_path", nargs="?", default=".",
        help="Path to the beads project (default: current directory)",
    )
    parser.add_argument(
        "-n", "--limit", type=int, default=0,
        help="Maximum dated events to show (default: 0 = unlimited, like "
             "'git log'). Uncommitted memory changes are not counted against "
             "it -- they are not in the history yet.",
    )
    parser.add_argument(
        "--only", default=None, metavar="VERBS",
        help="Comma-separated event verbs to include "
             f"(known: {', '.join(VERBS)}; 'start' and 'close' also accepted). "
             "Default: all.",
    )
    parser.add_argument(
        "--about", default=None, metavar="ENTITIES",
        help=f"Comma-separated entities to log ({', '.join(ENTITIES)}). "
             "Default: both, narrowing to beads under --id/--status "
             "(--open leaves the memories alone).",
    )
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument(
        "--status", default=None, metavar="LIST",
        help="Include only beads whose current status is in LIST "
             "(comma-separated; passed through to 'bd list --status'). "
             "Default: all statuses, incl. closed.",
    )
    scope.add_argument(
        "--open", action="store_true",
        help="Shorthand: include only beads that are still open (not closed).",
    )
    parser.add_argument(
        "--id", default=None, metavar="LIST",
        help="Include only these beads (comma-separated full bead ids; passed "
             "through to 'bd list --id'). Composes with --status/--open.",
    )
    parser.add_argument(
        "--children", action="store_true",
        help="With --id, also include every bead under each named id "
             "(the whole subtree, at any depth).",
    )
    parser.add_argument(
        "--since", default=None, metavar="DATE",
        help="Show only events on/after DATE (YYYY-MM-DD or RFC3339, UTC). "
             "Applies to every event kind, not just closures.",
    )
    parser.add_argument(
        "--oneline", action="store_true",
        help="Collapse each event to a single row (drops the actor and the "
             "close reason). Purely a render mode; the filters are unaffected.",
    )
    parser.add_argument(
        "--legend", choices=("auto", "always", "never"), default="auto",
        metavar="WHEN",
        help="Print the trailing symbol key (auto|always|never; default auto = "
             "only when stdout is a terminal, so pipes stay clean).",
    )
    parser.add_argument(
        "--no-pager", action="store_true",
        help="Write directly to stdout; skip the pager ($PAGER or less -FRX).",
    )
    add_color_arg(parser)
    add_version_arg(parser)
    args = parser.parse_args()

    if args.limit < 0:
        error("--limit must be >= 0 (0 means unlimited)")

    # 'is not None', not truthiness: --id '' is a passed-but-empty flag (an
    # unset shell variable, typically), which parse_ids rejects by name. Reading
    # it as "absent" would silently drop the filter and log the whole project.
    if args.children and args.id is None:
        error("--children needs --id (it widens the named ids to their subtrees)")

    verbs = parse_only(args.only) if args.only else set(VERBS)
    ids = parse_ids(args.id) if args.id is not None else None
    # 'is not None' for the same reason as --id above; parse_status then
    # guarantees a non-empty value, so the truthiness tests below are safe.
    if args.status is not None:
        parse_status(args.status)

    # Every bead filter narrows the beads row. Which of them additionally
    # implies "...and only the beads row" turns on whether this script knows
    # what the filter *means*.
    #
    # --id/--children enumerate what to log, and a memory is never one of the
    # ids typed, so logging every memory beside them buries the answer -- two
    # bead events under nineteen memory rows, on a repo with a few years of
    # 'bd remember' behind it.
    #
    # --status is an uninterpreted pass-through: bd owns that vocabulary and
    # its validation, and bd has custom statuses, so bd-log cannot tell a
    # live-ish list from a done-ish one and must not guess. Not knowing, it
    # reads --status as "asking about beads, by status". Guessing produced a
    # real defect: --status=closed used to return the whole memory log, so at
    # -n 8 it was six-eighths identical to --status=open.
    #
    # --open is the one predicate bd-log defines itself -- bd's default scope,
    # i.e. not closed, i.e. still in force -- so its meaning *can* be carried
    # across: every memory that hasn't been forgotten is in force too. It
    # therefore narrows the beads row and leaves the memories alone.
    #
    # (--open is not merely shorthand for --status=open. It passes no status
    # flag at all, so it also covers in_progress/blocked/deferred. The two are
    # different filters, which is what lets them differ here.)
    beads_only = [
        flag
        for flag, given in (
            ("--id", args.id is not None), ("--children", args.children),
            ("--status", args.status),
        )
        if given
    ]
    if args.about is not None:
        entities = parse_about(args.about)
        # --open joins the list only to be reported: it is just as inert as the
        # others when there is no beads row for it to filter.
        inert = beads_only + (["--open"] if args.open else [])
        if inert and "beads" not in entities:
            warn(f"{'/'.join(inert)} has no effect without --about=beads")
    else:
        entities = {"beads"} if beads_only else set(ENTITIES)

    kinds = select_kinds(entities, verbs)
    project_path = resolve_project_path(args.project_path)

    issues: list[dict] = []
    members: dict[str, set[str]] = {}
    scope = scope_args(args.status, args.open)
    if "beads" in entities:
        # Under --children the ids are matched locally, so bd must return the
        # whole scope for the subtree walk to have anything to narrow.
        issues = run_bd_list(project_path, scope, None if args.children else ids)

        if ids and args.children:
            # The walk needs the unfiltered topology (see select_subtrees). When
            # the scope already is --all -- the default -- that is what we just
            # fetched.
            topology = issues if scope == ["--all"] else run_bd_list(
                project_path, ["--all"], None,
            )
            issues, members = select_subtrees(issues, topology, ids)

    events = synthesize_events(issues, kinds)

    if "memories" in entities:
        from_dolt = memory_events(project_path, kinds)
        if from_dolt is None:
            # Silent under the default entity set: a repo with no Dolt database
            # (or no dolt CLI) would otherwise print this on every single run.
            # Only a user who named memories asked a question worth answering.
            if args.about is not None:
                warn(
                    "no memory history available (needs the 'dolt' CLI and a "
                    "Dolt-backed beads repo)"
                )
        else:
            events += from_dolt

    if args.since:
        events = filter_since(events, args.since)

    if ids and "beads" in entities:
        # Checked against the surviving events but *before* --limit trims them,
        # so a requested id only gets flagged when a filter (or a typo) really
        # left it with nothing -- never merely because -n cut it off. Memory
        # events are skipped rather than relied on to carry no 'id' field.
        covered = {issue_id(e[2]) for e in events if not is_memory(e[1])}
        if args.children:
            missing = [r for r in ids if not (members.get(r, set()) & covered)]
        else:
            missing = [r for r in ids if r not in covered]
        if missing:
            # Name only the filters actually in play. Listing every filter that
            # *could* explain the absence sends the reader hunting for a --since
            # they never passed.
            active = [
                flag
                for flag, given in (
                    ("--status", args.status), ("--open", args.open),
                    ("--only", args.only), ("--since", args.since),
                )
                if given
            ]
            cause = "not found"
            if active:
                cause += f", or excluded by {'/'.join(active)}"
            warn(f"no events for: {', '.join(missing)} ({cause})")

    # --limit trims the dated log only; see split_pending.
    pending, dated = split_pending(sort_events(events))
    if args.limit > 0:
        dated = dated[:args.limit]
    events = pending + dated

    if not events:
        print("no matching events")
        return 0

    # Both resolved here, not inside the `with`: paged_output yields the
    # pager's stdin pipe, which never looks like a tty even when the user is at
    # one. Testing the yielded stream would answer "no" in exactly the case
    # each of these is for.
    color = want_color(args.color)
    legend = want_legend(args.legend)
    if args.oneline:
        id_w, meta_w = oneline_widths(events)
        blocks = [
            [render_oneline(ts, kind, payload, id_w, meta_w, color)]
            for ts, kind, payload in events
        ]
    else:
        blocks = [render(ts, kind, payload, color) for ts, kind, payload in events]
    with paged_output(no_pager=args.no_pager) as out:
        # The pending group is labelled rather than left to be inferred from
        # the '(uncommitted)' stamps: the point that needs making is not that
        # these rows lack a date, which the stamp already says, but *why* --
        # that a date arrives when they are committed. Deliberately uncolored,
        # unlike every event line: color here means a verb, and this is not one.
        if pending:
            print(PENDING_HEADER, file=out)
        for i, block in enumerate(blocks):
            # A blank line separates multi-line blocks; --oneline rows are one
            # per event and run together, like 'git log --oneline'. The one
            # blank --oneline does get closes the pending group off from the
            # dated log, which is a section break rather than an entry break.
            if i and (not args.oneline or i == len(pending)):
                print(file=out)
            for line in block:
                print(line, file=out)
        if legend:
            print(file=out)
            for line in render_legend(color):
                print(line, file=out)

    return 0


if __name__ == "__main__":
    sys.exit(main())
