#!/usr/bin/env python3
"""Emit shell-completion candidates for beads-utils commands.

This is the single front door for every *dynamic* completion lookup: the zsh
and bash completion scripts call this and nothing else, so candidate logic is
never duplicated across shells. It is also the one place a TTL cache would
later wrap — adding caching here changes no call sites.

Each subcommand prints `value<TAB>description` lines to stdout. Lookups fail
silently (no output, exit 0) so a broken or slow command never garbles the
command line during completion.

  bd-complete ids        # bead ids (short form) + titles, from `bd list`
  bd-complete sessions   # Claude session uuids + titles
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

from bdutils import add_version_arg


def emit(value: str, description: str = "") -> None:
    """Print one `value<TAB>description` candidate line."""
    sys.stdout.write(f"{value}\t{description}\n")


def complete_ids() -> None:
    """Full bead ids (e.g. `beads-utils-v9o.4`) + titles, from `bd list`.

    Full ids rather than the short suffix: the shared project prefix makes a
    wrong-project mistake visible (and lets a full id pasted on the line still
    prefix-match).
    """
    try:
        proc = subprocess.run(
            ["bd", "list", "--status=all", "--limit", "0", "--json"],
            capture_output=True, text=True, check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return
    try:
        issues = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return
    if not isinstance(issues, list):
        return
    for issue in issues:
        full = (isinstance(issue, dict) and issue.get("id")) or ""
        if not full:
            continue
        emit(full, issue.get("title", "") or "")


def complete_sessions() -> None:
    """Claude session uuids + titles.

    Delegates to `claude-session-report --list-sessions`, which already emits
    `uuid<TAB>title` lines — so the project-dir walk lives in exactly one
    place rather than being duplicated here.
    """
    script = Path(__file__).resolve().with_name("claude-session-report")
    try:
        proc = subprocess.run(
            [str(script), "--list-sessions", "--no-pager"],
            capture_output=True, text=True, check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return
    sys.stdout.write(proc.stdout)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Emit shell-completion candidates "
                    "(value<TAB>description) for beads-utils commands.",
    )
    sub = parser.add_subparsers(dest="kind", required=True)
    sub.add_parser("ids", help="bead ids (short form) + titles")
    sub.add_parser("sessions", help="Claude session uuids + titles")
    add_version_arg(parser)
    args = parser.parse_args()

    if args.kind == "ids":
        complete_ids()
    elif args.kind == "sessions":
        complete_sessions()
    return 0


if __name__ == "__main__":
    sys.exit(main())
