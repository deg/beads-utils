#!/usr/bin/env python3
"""Verify that a beads project's Dolt data has been committed and pushed.

Dolt stores its data under refs/dolt/data in the Git remote — invisible in
GitHub's web UI but durable alongside your normal branches. This script
compares local Dolt state (embedded or server mode) against what's on the
remote and reports whether they're in sync.

Two axes, both of which have to hold: nothing left in the Dolt working set
(uncommitted data is in no commit, so no push can carry it), and no local
commits the remote hasn't got.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

from bdutils import (
    add_version_arg,
    dolt_count_range,
    dolt_fetch,
    dolt_rev,
    dolt_status,
    get_git_remote_url,
    get_head_branch,
    have_dolt,
    locate_dolt_db,
    read_dolt_remotes,
    read_metadata,
    resolve_project_path,
    run,
    strip_ansi,
)


def get_remote_dolt_ref(project_path: Path) -> str | None:
    result = run(["git", "ls-remote", "origin", "refs/dolt/data"], cwd=project_path)
    line = result.stdout.strip()
    if not line:
        return None
    return line.split()[0]


def derive_dolt_remote_url(git_url: str) -> str | None:
    """Best-effort: turn a git origin URL into a `bd dolt remote add` URL.

    `bd dolt push` needs a Dolt-flavored remote (git+ssh://, git+https://,
    az://, or DoltHub). It does not reuse the project's git origin, so we
    suggest the matching Dolt URL for the user to register manually.
    """
    if not git_url or git_url == "(no remote)":
        return None
    m = re.match(r"^(git@[^:]+):(.+)$", git_url)
    if m:
        return f"git+ssh://{m.group(1)}/{m.group(2)}"
    if git_url.startswith(("http://", "https://")):
        return f"git+{git_url}"
    if git_url.startswith(("git+ssh://", "git+https://", "az://")):
        return git_url
    return None


def get_recent_dolt_log(dolt_db_dir: Path, n: int = 5) -> list[str]:
    if not have_dolt():
        return []
    result = run(["dolt", "log", "--oneline", "-n", str(n)], cwd=dolt_db_dir)
    if result.returncode != 0:
        return []
    return [strip_ansi(line) for line in result.stdout.splitlines() if line.strip()]


def tables_phrase(n: int) -> str:
    """'1 table' / '2 tables' — one pluralization for every line below."""
    return f"{n} table{'s' if n != 1 else ''}"


def dolt_commit_command(dolt_db_dir: Path, db_name: str, rows: list[dict]) -> str:
    """A `dolt sql` one-liner that commits exactly the dirty tables.

    Rooted at the database dir's *parent*, which is the one spelling that
    works in both layouts: in server mode that is the sql-server's data dir,
    where the CLI finds `.dolt/sql-server.info` and proxies to the running
    server instead of writing the files underneath it; in embedded mode it is
    simply a directory holding one database. Both were run and checked.
    """
    tables = ", ".join(repr(str(r.get("table_name", ""))) for r in rows)
    return (f'cd {dolt_db_dir.parent} && dolt sql -q "use {db_name}; '
            f"call dolt_add({tables}); "
            f"call dolt_commit('-m', 'commit pending changes')\"")


def print_working_set(rows: list[dict] | None, dolt_db_dir: Path | None,
                      db_name: str, dolt_mode: str = "") -> None:
    """Report the Dolt working set: what is changed but in no commit.

    Printed before anything touches the remote, because this is purely local
    truth — a repo with no Dolt remote at all still needs to hear it. `rows`
    is dolt_status()'s result: None = could not look, [] = looked and clean.
    Both are stated out loud rather than skipped; silence reading as "fine" is
    the failure this check exists to end.
    """
    if rows is None:
        print("Working set:  not verifiable (needs the dolt CLI and a local Dolt database)")
        print()
        return
    if not rows:
        print("Working set:  clean")
        print()
        return
    print(f"Working set:  {tables_phrase(len(rows))} with uncommitted changes")
    width = max(len(str(r.get("status", "?"))) for r in rows)
    for row in rows:
        print(f"  {str(row.get('status', '?')):<{width}}  {row.get('table_name', '?')}")
    print("  These changes are in no commit, so no push can include them.")
    # The remedy differs by mode, because `bd dolt commit` only works in one of
    # them. Both halves were run at bd 1.1.0, in pristine repos of each mode:
    # embedded, auto-commit off -> `bd dolt commit` clears config/events/issues
    # together; server -> it prints "Committed." and clears nothing, and
    # `bd vc commit` answers with the *existing* HEAD's hash. What does work in
    # server mode is `bd dolt stop`, which commits as it shuts down
    # ("auto-flush: commit working set before server stop").
    if dolt_mode == "server":
        print("  Run 'bd dolt stop', then 'bd dolt push'. Stopping flushes and")
        print("  commits the working set; bd restarts the server when next needed.")
        print("  'bd dolt commit' does NOT clear this in server mode — it reports")
        print("  success and commits nothing (bd 1.1.0).")
        if dolt_db_dir is not None:
            print("  If the server is not running, there is nothing to flush; commit")
            print("  with dolt itself:")
            print(f"    {dolt_commit_command(dolt_db_dir, db_name, rows)}")
    else:
        print("  Run 'bd dolt commit', then 'bd dolt push'.")
    print()


def print_unverifiable(n_dirty: int, detail: str) -> int:
    """Status line for "the remote has data, but the commit delta is unknown".

    Exits 1 when the working set is dirty: failing to compute the commit delta
    says nothing about data that is in no commit to begin with.
    """
    if n_dirty:
        print(f"Status:  UNCOMMITTED — {tables_phrase(n_dirty)} uncommitted; "
              "sync delta not verifiable")
    else:
        print("Status:  remote has Dolt data — sync delta not verifiable")
    print(f"         ({detail})")
    return 1 if n_dirty else 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Verify a beads project's Dolt data has been committed and pushed to its remote.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  bd-dolt-check          Check the current directory\n"
            "  bd-dolt-check <path>   Check a specific beads repo\n"
        ),
    )
    parser.add_argument(
        "project_path", nargs="?", default=".",
        help="Path to the beads project (default: current directory)",
    )
    add_version_arg(parser)
    args = parser.parse_args()

    project_path = resolve_project_path(args.project_path)
    beads_dir = project_path / ".beads"

    db_name, dolt_mode = read_metadata(beads_dir)
    remote_url = get_git_remote_url(project_path)

    print(f"Repository:  {project_path}")
    print(f"Remote:      {remote_url}")
    print(f"Dolt DB:     {db_name} (mode: {dolt_mode})")
    print()

    dolt_db_dir = locate_dolt_db(beads_dir, db_name)
    dolt_remotes = read_dolt_remotes(dolt_db_dir) if dolt_db_dir else {}

    dirty = dolt_status(dolt_db_dir) if dolt_db_dir is not None else None
    n_dirty = len(dirty) if dirty else 0
    print_working_set(dirty, dolt_db_dir, db_name, dolt_mode)

    remote_ref = get_remote_dolt_ref(project_path)
    if remote_ref is None:
        print("Remote:  refs/dolt/data NOT FOUND")
        print()
        if not dolt_remotes:
            print("No Dolt remote is configured for this beads project.")
            print("(`bd dolt push` uses remotes registered via `bd dolt remote add`;")
            print(" it does NOT auto-derive from your git `origin`.)")
            print()
            suggested = derive_dolt_remote_url(remote_url)
            if suggested:
                print("To configure (matching your git origin):")
                print(f"  bd dolt remote add origin {suggested}")
                print("  bd dolt push")
            else:
                print("To configure, run:")
                print("  bd dolt remote add origin <url>")
                print("  bd dolt push")
        else:
            print("A Dolt remote is configured, but data has never been pushed.")
            print("Configured Dolt remotes:")
            for name, url in dolt_remotes.items():
                print(f"  {name}: {url}")
            print()
            print("Run 'bd dolt push' to push.")
        return 1

    print(f"Remote:  refs/dolt/data = {remote_ref[:12]}...")

    if dolt_db_dir is not None:
        if dolt_remotes:
            print()
            print("Dolt remotes configured:")
            for name, url in dolt_remotes.items():
                print(f"  {name}: {url}")
        recent = get_recent_dolt_log(dolt_db_dir, n=5)
        if recent:
            print()
            print("Recent Dolt commits (local history; NOT a pending-push list):")
            for line in recent:
                print(f"  {line}")
    else:
        print()
        print("Warning: Dolt database directory not found")
        print(f"  Checked: {beads_dir / 'embeddeddolt' / db_name}")
        print(f"           {beads_dir / 'dolt' / db_name}")

    print()
    if dolt_db_dir is None or not have_dolt():
        return print_unverifiable(
            n_dirty,
            "run from the project dir with the dolt CLI installed for a full check",
        )

    branch = get_head_branch(dolt_db_dir)
    remote_name = "origin" if "origin" in dolt_remotes else next(iter(dolt_remotes), "origin")
    tracking_ref = f"remotes/{remote_name}/{branch}"

    if not dolt_fetch(dolt_db_dir, remote_name):
        print(f"Note: 'dolt fetch {remote_name}' failed; comparing against the last-known")
        print("      remote-tracking ref (a remote that moved ahead may be missed).")
        print()

    local_head = dolt_rev(dolt_db_dir, branch)
    tracking_head = dolt_rev(dolt_db_dir, tracking_ref)

    if local_head is None:
        return print_unverifiable(
            n_dirty, f"could not read local Dolt HEAD for branch '{branch}'")
    if tracking_head is None:
        return print_unverifiable(
            n_dirty,
            f"no local remote-tracking ref '{tracking_ref}'; run 'bd dolt push' once",
        )

    if local_head == tracking_head:
        if n_dirty:
            print(f"Status:  UNCOMMITTED — commits in sync, "
                  f"{tables_phrase(n_dirty)} not committed")
            return 1
        print(f"Status:  IN SYNC (local {branch} matches {tracking_ref})")
        return 0

    ahead = dolt_count_range(dolt_db_dir, f"{tracking_ref}..{branch}") or 0
    behind = dolt_count_range(dolt_db_dir, f"{branch}..{tracking_ref}") or 0

    # The two failures are independent, so a dirty working set rides along as a
    # clause rather than replacing the commit verdict. Its remedy was printed
    # with the working-set section above and is not repeated here — except
    # where the action is a *pull*: pulling onto a dirty working set is the one
    # combination that can conflict rather than merely be incomplete, and this
    # line is the last thing on screen.
    also = f"; {tables_phrase(n_dirty)} uncommitted" if n_dirty else ""
    commit_first = "Run 'bd dolt commit', then " if n_dirty else "Run "
    if ahead and behind:
        print(f"Status:  DIVERGED — {ahead} local commit(s) unpushed, {behind} remote commit(s) unpulled{also}")
        action = f"{commit_first}'bd dolt pull' then 'bd dolt push' to reconcile."
    elif ahead:
        print(f"Status:  OUT OF SYNC — {ahead} local commit(s) not pushed{also}")
        action = "Run 'bd dolt push' to sync."
    elif behind:
        print(f"Status:  BEHIND — {behind} remote commit(s) not pulled{also}")
        action = f"{commit_first}'bd dolt pull' to update local."
    else:
        print(f"Status:  OUT OF SYNC — local and remote-tracking heads differ (delta not countable){also}")
        action = "Run 'bd dolt pull' / 'bd dolt push' to reconcile."
    print(f"  local ({branch}):           {local_head}")
    print(f"  remote ({tracking_ref}): {tracking_head}")
    print()
    print(action)
    return 1


if __name__ == "__main__":
    sys.exit(main())
